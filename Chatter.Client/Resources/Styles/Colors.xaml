<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Chatter's dark Material palette. Keeps the stock MAUI template's key names (Primary,
         Gray100-950, etc.) since UraniumUI.Material's ColorsOverride reads this dictionary to
         theme its own controls - only the values changed, from the default light-purple template
         palette to the app's dark-navy one. See Theme.xaml for the app's own semantic aliases
         (ColorSurface, ColorOnSurface, ...) used directly by page XAML. -->

    <Color x:Key="Primary">#8B5CF6</Color>
    <Color x:Key="PrimaryDark">#A78BFA</Color>
    <Color x:Key="PrimaryDarkText">#0B1220</Color>
    <Color x:Key="Secondary">#0D1524</Color>
    <Color x:Key="SecondaryDarkText">#E5E7EB</Color>
    <Color x:Key="Tertiary">#6EE7F9</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#0B1220</Color>

    <Color x:Key="Gray100">#E5E7EB</Color>
    <Color x:Key="Gray200">#D1D5DB</Color>
    <Color x:Key="Gray300">#9CA3AF</Color>
    <Color x:Key="Gray400">#6B7280</Color>
    <Color x:Key="Gray500">#374151</Color>
    <Color x:Key="Gray600">#1F2937</Color>
    <Color x:Key="Gray900">#101827</Color>
    <Color x:Key="Gray950">#0B1220</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
