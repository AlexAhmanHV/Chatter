<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
    Chatter's own Material-role color/type/shape tokens - the single source of truth every page
    should reference instead of redeclaring its own local palette (the "stapplig och gammaldags"
    complaint this redesign addresses: five pages each hand-rolling a near-identical, slightly
    drifted set of hex colors). Values intentionally match Colors.xaml's dark palette so UraniumUI
    Material's own controls (which read Colors.xaml via ColorsOverride) and this app's custom
    chrome (cards, gradients, bubbles) look like one consistent system rather than two.
    -->

    <!-- Color roles -->
    <Color x:Key="ColorPrimary">#8B5CF6</Color>
    <Color x:Key="ColorPrimaryVariant">#6EE7F9</Color>
    <Color x:Key="ColorOnPrimary">#0B1220</Color>

    <Color x:Key="ColorBackground">#0B1220</Color>
    <Color x:Key="ColorSurface">#101827</Color>
    <Color x:Key="ColorSurfaceVariant">#0D1524</Color>

    <Color x:Key="ColorOnSurface">#E5E7EB</Color>
    <Color x:Key="ColorOnSurfaceVariant">#9CA3AF</Color>

    <Color x:Key="ColorOutline">#1F2937</Color>
    <Color x:Key="ColorOutlineFocus">#8B5CF6</Color>

    <Color x:Key="ColorError">#DC2626</Color>
    <Color x:Key="ColorSuccess">#22C55E</Color>
    <Color x:Key="ColorWarning">#F59E0B</Color>

    <SolidColorBrush x:Key="ColorPrimaryBrush" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="ColorSurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="ColorOutlineBrush" Color="{StaticResource ColorOutline}" />

    <!-- Shape scale -->
    <x:Double x:Key="RadiusSm">8</x:Double>
    <x:Double x:Key="RadiusMd">14</x:Double>
    <x:Double x:Key="RadiusLg">20</x:Double>

    <!-- Type scale -->
    <Style x:Key="TypeDisplay" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ColorOnSurface}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="36" />
    </Style>
    <Style x:Key="TypeTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ColorOnSurface}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="20" />
    </Style>
    <Style x:Key="TypeBody" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ColorOnSurface}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="TypeLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ColorOnSurfaceVariant}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="TypeCaption" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ColorOnSurfaceVariant}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Elevation - Border.Shadow can bind directly to these -->
    <Shadow x:Key="ElevationLevel1" Brush="Black" Opacity="0.25" Radius="8" Offset="0,2" />
    <Shadow x:Key="ElevationLevel2" Brush="Black" Opacity="0.30" Radius="14" Offset="0,4" />

    <!-- Card surface - the repeated "Border wrapping a section" pattern every page uses -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSurface}" />
        <Setter Property="Stroke" Value="{StaticResource ColorOutline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="{StaticResource RadiusLg}" />
        </Setter>
        <Setter Property="Shadow" Value="{StaticResource ElevationLevel1}" />
    </Style>

    <!-- A single glyph-label style every Material Symbols icon usage shares -->
    <Style x:Key="IconGlyph" TargetType="Label">
        <Setter Property="FontFamily" Value="MaterialSymbolsOutlined" />
        <Setter Property="TextColor" Value="{StaticResource ColorOnSurfaceVariant}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- Flat Material buttons - no gradients anywhere. UraniumUI.Material doesn't ship its own
         Button variants, so these two named styles (filled primary action / outlined secondary
         action) are the app's whole button vocabulary, replacing every page's own copy-pasted
         gradient button styles. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource ColorOnPrimary}" />
        <Setter Property="BackgroundColor" Value="{StaticResource ColorPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="0,16" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource ColorOnSurface}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="{StaticResource ColorOutline}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="0,16" />
    </Style>

</ResourceDictionary>
