<?xml version="1.0" encoding="utf-8"?>
<!--
File: CallPage.xaml

What this does:
- Purpose: Full-screen call UI - the WebRTC video surface (HybridWebView, see
  Resources/Raw/wwwroot/call.html) plus an overlay for status text and mute/camera/hangup
  controls.
- How: Binds to CallViewModel. The HybridWebView itself isn't data-bound (RawMessageReceived is
  wired in code-behind via CallViewModel.AttachWebView) since HybridWebView's message channel
  isn't a bindable property. Styled with the app's shared Material theme (Resources/Styles/Theme.xaml,
  merged locally - see LoginPage.xaml's comment on why not at the App level).
-->
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Chatter.Client.ViewModels"
    xmlns:conv="clr-namespace:Chatter.Client.Converters"
    xmlns:symbols="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    x:Class="Chatter.Client.Views.CallPage"
    x:DataType="vm:CallViewModel"
    Title="Call"
    BackgroundColor="{StaticResource ColorBackground}"
    NavigationPage.HasNavigationBar="False">

  <ContentPage.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Styles/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:MuteButtonTextConverter x:Key="MuteButtonText" />
      <conv:CameraButtonTextConverter x:Key="CameraButtonText" />
    </ResourceDictionary>
  </ContentPage.Resources>

  <Grid>
    <HybridWebView x:Name="CallWebView"
                   HybridRoot="wwwroot"
                   DefaultFile="call.html" />

    <VerticalStackLayout VerticalOptions="Start" HorizontalOptions="Center" Margin="0,24,0,0" Spacing="4">
      <Label Text="{Binding PeerDisplayName}" Style="{StaticResource TypeTitle}" HorizontalOptions="Center" />
      <Label Text="{Binding StatusText}" Style="{StaticResource TypeCaption}" HorizontalOptions="Center" />
    </VerticalStackLayout>

    <HorizontalStackLayout VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,32" Spacing="20">
      <Button Text="{Binding IsMuted, Converter={StaticResource MuteButtonText}}"
              Command="{Binding ToggleMuteCommand}"
              FontFamily="MaterialSymbolsOutlined"
              WidthRequest="56" HeightRequest="56" CornerRadius="28" FontSize="24" Padding="0"
              BackgroundColor="{StaticResource ColorSurfaceVariant}" TextColor="{StaticResource ColorOnSurface}" />
      <Button Text="{Binding IsCameraOff, Converter={StaticResource CameraButtonText}}"
              Command="{Binding ToggleCameraCommand}"
              FontFamily="MaterialSymbolsOutlined"
              WidthRequest="56" HeightRequest="56" CornerRadius="28" FontSize="24" Padding="0"
              BackgroundColor="{StaticResource ColorSurfaceVariant}" TextColor="{StaticResource ColorOnSurface}" />
      <Button Text="{x:Static symbols:MaterialOutlined.Call_end}"
              Command="{Binding HangupCommand}"
              FontFamily="MaterialSymbolsOutlined"
              WidthRequest="56" HeightRequest="56" CornerRadius="28" FontSize="24" Padding="0"
              BackgroundColor="{StaticResource ColorError}" TextColor="White" />
    </HorizontalStackLayout>
  </Grid>
</ContentPage>
