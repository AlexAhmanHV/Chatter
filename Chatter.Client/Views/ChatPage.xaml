<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chatter.Client.Views.ChatPage"
             Title="Chat">

  <!-- Give the toolbar item a name; no inline Clicked -->
  <ContentPage.ToolbarItems>
    <ToolbarItem x:Name="SettingsItem" Text="Settings" />
  </ContentPage.ToolbarItems>

  <Grid ColumnSpacing="0" RowSpacing="0" Padding="0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />  <!-- LEFT: chats -->
      <ColumnDefinition Width="*" />    <!-- MIDDLE: conversation -->
      <ColumnDefinition Width="280" />  <!-- RIGHT: people -->
    </Grid.ColumnDefinitions>

    <!-- LEFT: Chats list -->
    <Border Grid.Column="0" StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light=#F7F7F7, Dark=#1A1A1A}">
      <VerticalStackLayout Padding="12" Spacing="8">
        <Label Text="Chats" FontAttributes="Bold" />

        <CollectionView ItemsSource="{Binding Chats}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedChat}">
          <CollectionView.ItemTemplate>
            <DataTemplate>
              <Grid Padding="8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Chat label -->
                <Label Text="{Binding Label}" LineBreakMode="TailTruncation">
                  <Label.Triggers>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding Id}"
                                 Value="Lobby">
                      <Setter Property="FontAttributes" Value="Bold" />
                    </DataTrigger>
                  </Label.Triggers>
                </Label>

                <!-- Unread badge -->
                <Border Grid.Column="1"
                        BackgroundColor="#CCFF3B30"
                        Padding="6,2"
                        StrokeThickness="0"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        IsVisible="True">
                  <Border.Triggers>
                    <!-- Hide when unread is 0 -->
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding Unread}"
                                 Value="0">
                      <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                  </Border.Triggers>
                  <Label Text="{Binding Unread}" FontAttributes="Bold" FontSize="12" />
                </Border>
              </Grid>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>
      </VerticalStackLayout>
    </Border>

    <!-- MIDDLE: Current conversation -->
    <Grid Grid.Column="1" Padding="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <CollectionView Grid.Row="0" ItemsSource="{Binding CurrentChatMessages}">
        <CollectionView.ItemTemplate>
          <DataTemplate>
            <Label Text="{Binding .}" LineBreakMode="WordWrap" Margin="0,2"/>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>

      <Grid Grid.Row="1" ColumnSpacing="8" Padding="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Name the entry; no inline Completed -->
        <Entry x:Name="MessageEntry"
               Grid.Column="0"
               Placeholder="{Binding MessagePlaceholder}"
               Text="{Binding OutgoingMessage}"
               Keyboard="Chat"
               ReturnType="Send" />

        <Button Grid.Column="1"
                Text="Send"
                Command="{Binding SendCommand}"
                IsEnabled="{Binding CanSend}" />
      </Grid>
    </Grid>

    <!-- RIGHT: People (online + offline) -->
    <Border Grid.Column="2" StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light=#F5F5F7, Dark=#1E1E1E}">
      <VerticalStackLayout Padding="16" Spacing="8">
        <Label Text="{Binding User, StringFormat='Chatting as: {0}'}"
               FontSize="14"
               FontAttributes="Italic"
               TextColor="Gray"
               Margin="0,0,0,6" />

        <Label Text="People" FontAttributes="Bold" />

        <!-- Counters -->
<HorizontalStackLayout Spacing="12">
  <Label Text="{Binding People.Count, StringFormat='Total: {0}'}" FontSize="12" TextColor="Gray" />
  <Label Text="{Binding OnlineUsers.Count, StringFormat='Online: {0}'}" FontSize="12" TextColor="Gray" />
  <Label Text="{Binding OfflineCount, StringFormat='Offline: {0}'}" FontSize="12" TextColor="Gray" />
</HorizontalStackLayout>

        <!-- Name the list; no inline SelectionChanged -->
        <CollectionView x:Name="PeopleList"
                        ItemsSource="{Binding People}"
                        SelectionMode="Single">
          <CollectionView.ItemTemplate>
            <DataTemplate>
              <Grid Padding="0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Presence dot -->
                <Ellipse WidthRequest="8"
                         HeightRequest="8"
                         VerticalOptions="Center">
                  <Ellipse.Triggers>
                    <DataTrigger TargetType="Ellipse"
                                 Binding="{Binding IsOnline}"
                                 Value="True">
                      <Setter Property="Fill" Value="LimeGreen" />
                    </DataTrigger>
                    <DataTrigger TargetType="Ellipse"
                                 Binding="{Binding IsOnline}"
                                 Value="False">
                      <Setter Property="Fill" Value="#FF3B30" />
                    </DataTrigger>
                  </Ellipse.Triggers>
                </Ellipse>

                <!-- Name -->
                <Label Grid.Column="1"
                       Text="{Binding Name}"
                       Margin="8,0,0,0" />
              </Grid>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>
      </VerticalStackLayout>
    </Border>
  </Grid>
</ContentPage>
