<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chatter.Client.Views.ChatPage"
             Title="Chat">
             <ContentPage.ToolbarItems>
    <ToolbarItem Text="Settings" Clicked="OnSettingsClicked" />
  </ContentPage.ToolbarItems>
  <VerticalStackLayout Padding="16" Spacing="8">

    <!-- Username row -->
    <HorizontalStackLayout Spacing="8" VerticalOptions="Start">
      <Label HorizontalOptions="Center" Margin="0,0,0,8" FontSize="14">
        <Label.FormattedText>
          <FormattedString>
            <Span Text="👤 Logged in as: " />
            <Span Text="{Binding User}" />
          </FormattedString>
        </Label.FormattedText>
      </Label>
      
    </HorizontalStackLayout>


    <CollectionView ItemsSource="{Binding Messages}" HeightRequest="300"/>
    <HorizontalStackLayout Spacing="8">
      <Entry Placeholder="Type a message…" Text="{Binding OutgoingMessage}" HorizontalOptions="FillAndExpand"/>
      <Button Text="Send" Command="{Binding SendCommand}"/>
    </HorizontalStackLayout>

  </VerticalStackLayout>
</ContentPage>
