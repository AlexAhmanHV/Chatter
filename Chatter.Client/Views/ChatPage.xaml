<?xml version="1.0" encoding="utf-8"?>
<!--
File: ChatPage.xaml

What this does:
- Purpose: Main chat screen showing the chats list (left), current conversation (middle), and people/status panel (right).
- How: Binds to ChatViewModel with compiled bindings (x:DataType). Message bubbles use EmojiDisplayConverter.
       Deleting a chat is wired via a double-tap gesture handled in code-behind (OnDeleteChatTapped) to avoid BindingContext pitfalls.
       Styles/resources define gradients, cards, pills, and input borders used across the layout.
- Where used: Primary app page (Shell route “ChatPage”) after connecting/logging in; interacts with ChatViewModel commands and observable collections.
-->

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Chatter.Client.ViewModels"
    xmlns:models="clr-namespace:Chatter.Client.Models"
    xmlns:conv="clr-namespace:Chatter.Client.Converters"
    x:Class="Chatter.Client.Views.ChatPage"
    x:Name="ChatPageRoot"
    x:DataType="vm:ChatViewModel"
    Title="Chat"
    BackgroundColor="#0B1220"
    NavigationPage.HasNavigationBar="True"
    NavigationPage.BarBackgroundColor="#0B1220"
    NavigationPage.BarTextColor="#E5E7EB">

  <!-- Toolbar -->
  <ContentPage.ToolbarItems>
    <ToolbarItem Text="New group"
                 Order="Primary"
                 Priority="0"
                 Command="{Binding CreateGroupChatCommand}">
      <ToolbarItem.IconImageSource>
        <FontImageSource Glyph="👥" Size="20" Color="#E5E7EB" />
      </ToolbarItem.IconImageSource>
    </ToolbarItem>
    <ToolbarItem x:Name="SettingsItem"
                 Text="Settings"
                 Order="Secondary"
                 Priority="0">
      <ToolbarItem.IconImageSource>
        <FontImageSource Glyph="⚙" Size="22" Color="#E5E7EB" />
      </ToolbarItem.IconImageSource>
    </ToolbarItem>
  </ContentPage.ToolbarItems>

  <!-- Resources -->
  <ContentPage.Resources>
    <ResourceDictionary>
      <conv:EmojiDisplayConverter x:Key="EmojiDisplay" />
      <conv:InvertedBoolConverter x:Key="InvertBool" />
      <conv:AttachmentStatusTextConverter x:Key="AttachmentStatusText" />
      <conv:RecordButtonTextConverter x:Key="RecordButtonText" />
      <conv:RecordButtonBackgroundConverter x:Key="RecordButtonBackground" />
      <Color x:Key="PrimaryStart">#6EE7F9</Color>
      <Color x:Key="PrimaryEnd">#8B5CF6</Color>
      <Color x:Key="CardBg">#101827</Color>
      <Color x:Key="PanelBg">#0D1524</Color>
      <Color x:Key="StrokeIdle">#1F2937</Color>
      <Color x:Key="StrokeFocus">#8B5CF6</Color>
      <Color x:Key="TextPrimary">#E5E7EB</Color>
      <Color x:Key="TextSecondary">#9CA3AF</Color>
      <Color x:Key="BubbleBg">#0F1B2E</Color>
      <x:Double x:Key="RadiusLg">20</x:Double>
      <x:Double x:Key="RadiusMd">14</x:Double>

      <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource PrimaryStart}" Offset="0.0" />
        <GradientStop Color="{StaticResource PrimaryEnd}" Offset="1.0" />
      </LinearGradientBrush>

      <Style TargetType="Button" x:Key="PrimaryBtn">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Background">
          <Setter.Value>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="{StaticResource PrimaryStart}" Offset="0.0" />
              <GradientStop Color="{StaticResource PrimaryEnd}" Offset="1.0" />
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
          <Setter.Value>
            <Shadow Opacity="0.35" Radius="14" Offset="0,6" />
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="Border" x:Key="FieldBorder">
        <Setter Property="Stroke" Value="{StaticResource StrokeIdle}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="BackgroundColor" Value="{StaticResource PanelBg}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="StrokeShape">
          <Setter.Value>
            <RoundRectangle CornerRadius="{StaticResource RadiusMd}" />
          </Setter.Value>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
          <Setter.Value>
            <VisualStateGroupList>
              <VisualStateGroup>
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Property="Stroke" Value="{StaticResource StrokeFocus}" />
                    <Setter Property="StrokeThickness" Value="2" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateGroupList>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="Border" x:Key="Card">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
        <Setter Property="Stroke" Value="{StaticResource StrokeIdle}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeShape">
          <Setter.Value>
            <RoundRectangle CornerRadius="{StaticResource RadiusLg}" />
          </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
          <Setter.Value>
            <Shadow Opacity="0.25" Radius="18" Offset="0,10" />
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="Border" x:Key="Pill">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background">
          <Setter.Value>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="{StaticResource PrimaryStart}" Offset="0.0" />
              <GradientStop Color="{StaticResource PrimaryEnd}" Offset="1.0" />
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
          <Setter.Value>
            <RoundRectangle CornerRadius="12" />
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </ContentPage.Resources>

  <!-- Layout -->
  <Grid ColumnSpacing="0" RowSpacing="0" Padding="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>

    <!-- Decorative gradients -->
    <Ellipse Grid.ColumnSpan="3" WidthRequest="280" HeightRequest="280" Opacity="0.22"
             HorizontalOptions="Start" VerticalOptions="Start" TranslationX="-120" TranslationY="-120">
      <Ellipse.Fill>
        <RadialGradientBrush Radius="0.9" Center="0.7,0.4">
          <GradientStop Color="{StaticResource PrimaryStart}" Offset="0" />
          <GradientStop Color="#00000000" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse Grid.ColumnSpan="3" WidthRequest="340" HeightRequest="340" Opacity="0.18"
             HorizontalOptions="End" VerticalOptions="End" TranslationX="80" TranslationY="100">
      <Ellipse.Fill>
        <RadialGradientBrush Radius="1.0" Center="0.3,0.6">
          <GradientStop Color="{StaticResource PrimaryEnd}" Offset="0" />
          <GradientStop Color="#00000000" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <!-- LEFT: Chats -->
    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
      <VerticalStackLayout Spacing="0">
        <Border Padding="20,22" StrokeThickness="0" Background="{StaticResource HeaderBrush}">
          <VerticalStackLayout Spacing="6">
            <Label Text="💬 Messages" FontSize="20" FontAttributes="Bold" TextColor="White" />
            <Label Text="Your conversations" FontSize="12" TextColor="White" Opacity="0.85" />
          </VerticalStackLayout>
        </Border>

        <ScrollView Padding="12,14">
          <CollectionView x:Name="ChatsCollection"
                          ItemsSource="{Binding Chats}"
                          SelectionMode="Single"
                          SelectedItem="{Binding SelectedChat, Mode=TwoWay}">
            <CollectionView.ItemTemplate>
              <DataTemplate x:DataType="models:ChatItem">
                <Border BackgroundColor="{StaticResource PanelBg}"
                        Padding="12" Margin="0,0,0,10"
                        StrokeThickness="1" Stroke="{StaticResource StrokeIdle}">
                  <!-- Double-tap to delete: handled in code-behind to avoid any BindingContext paths -->
                  <Border.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="2"
                                          Tapped="OnDeleteChatTapped" />
                  </Border.GestureRecognizers>

                  <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                  </Border.StrokeShape>

                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Delete icon (visual) -->
                    <Border Grid.Column="0" WidthRequest="32" HeightRequest="32" BackgroundColor="#251622" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Center">
                      <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                      </Border.StrokeShape>
                      <Label Text="✕" FontSize="16" TextColor="#F87171"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                        <Label.Triggers>
                          <DataTrigger TargetType="Label" Binding="{Binding Id}" Value="Lobby">
                            <Setter Property="IsVisible" Value="False" />
                          </DataTrigger>
                        </Label.Triggers>
                      </Label>
                    </Border>

                    <!-- Chat info -->
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                      <HorizontalStackLayout Spacing="4">
                        <Label Text="{Binding Label}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation">
                          <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding Id}" Value="Lobby">
                              <Setter Property="TextColor" Value="{StaticResource PrimaryStart}" />
                            </DataTrigger>
                          </Label.Triggers>
                        </Label>
                        <Label Text="🔇" FontSize="11" IsVisible="{Binding IsMuted}" VerticalOptions="Center" />
                      </HorizontalStackLayout>
                      <Label Text="Tap to open" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <!-- Unread -->
                    <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalOptions="Center" IsVisible="True">
                      <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding Unread}" Value="0">
                          <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                      </Border.Triggers>
                      <Label Text="{Binding Unread}" FontAttributes="Bold" FontSize="11" TextColor="White" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>
        </ScrollView>
      </VerticalStackLayout>
    </Border>

    <!-- MIDDLE: Conversation -->
    <Grid Grid.Column="1" Margin="0" RowSpacing="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,12,12">
        <VerticalStackLayout Spacing="10">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeThickness="0" Background="{StaticResource HeaderBrush}">
              <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
              </Border.StrokeShape>
              <Label Text="💬" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"
                     HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
              <HorizontalStackLayout Spacing="6">
                <Label Text="{Binding SelectedChat.Label, FallbackValue='Select a chat'}"
                       FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                <Label Text="🔇" FontSize="13" IsVisible="{Binding SelectedChat.IsMuted, FallbackValue=False}" VerticalOptions="Center" />
              </HorizontalStackLayout>
              <HorizontalStackLayout Spacing="8">
                <Label Text="Messages" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                <Border Style="{StaticResource Pill}" Padding="8,2" VerticalOptions="Center">
                  <Label Text="{Binding CurrentChatMessages.Count, StringFormat='{0}'}"
                         FontSize="11" FontAttributes="Bold" TextColor="White" />
                </Border>
              </HorizontalStackLayout>
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="🔍"
                    Command="{Binding ToggleSearchCommand}"
                    WidthRequest="40" HeightRequest="40" FontSize="16" Padding="0"
                    BackgroundColor="#1F2937" TextColor="{StaticResource TextPrimary}" CornerRadius="20" />
            <!-- ManageChatCommand no-ops for Lobby/drafts/no selection, so this can always be visible. -->
            <Button Grid.Column="3" Text="⋮"
                    Command="{Binding ManageChatCommand}"
                    WidthRequest="40" HeightRequest="40" FontSize="18" Padding="0"
                    BackgroundColor="#1F2937" TextColor="{StaticResource TextPrimary}" CornerRadius="20" />
          </Grid>

          <Grid IsVisible="{Binding IsSearching}" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Border Grid.Column="0" Style="{StaticResource FieldBorder}">
              <Entry Placeholder="Search this chat…"
                     Text="{Binding SearchQuery}"
                     TextColor="{StaticResource TextPrimary}"
                     PlaceholderColor="{StaticResource TextSecondary}"
                     BackgroundColor="Transparent" />
            </Border>
            <Label Grid.Column="1" Text="…" FontSize="20" VerticalOptions="Center"
                   TextColor="{StaticResource TextSecondary}" IsVisible="{Binding IsSearchRunning}" />
          </Grid>

          <CollectionView IsVisible="{Binding IsSearching}" ItemsSource="{Binding SearchResults}" MaximumHeightRequest="260">
            <CollectionView.ItemTemplate>
              <DataTemplate x:DataType="models:ChatMessageItem">
                <Border Padding="10,8" Margin="0,0,0,6" StrokeThickness="1"
                        Stroke="{StaticResource StrokeIdle}" BackgroundColor="{StaticResource PanelBg}">
                  <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                  <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSearchResultTapped" />
                  </Border.GestureRecognizers>
                  <VerticalStackLayout Spacing="2">
                    <HorizontalStackLayout Spacing="6">
                      <Label Text="{Binding Sender}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource PrimaryStart}" />
                      <Label Text="{Binding SentAtUtc, StringFormat='{0:g}'}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding Body}" FontSize="13" LineBreakMode="TailTruncation" MaxLines="2" TextColor="{StaticResource TextPrimary}" />
                  </VerticalStackLayout>
                </Border>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>
        </VerticalStackLayout>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,12,12">
        <ScrollView>
          <VerticalStackLayout Spacing="10">
            <Button Text="Load earlier messages"
                    Command="{Binding LoadMoreHistoryCommand}"
                    IsVisible="{Binding CanLoadMoreHistory}"
                    BackgroundColor="#1F2937"
                    TextColor="{StaticResource TextSecondary}"
                    FontSize="12"
                    HeightRequest="36"
                    CornerRadius="10"
                    HorizontalOptions="Center" />

            <CollectionView x:Name="MessagesList" ItemsSource="{Binding CurrentChatMessages}">
              <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
              </CollectionView.ItemsLayout>
              <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessageItem">
                  <SwipeView>
                    <SwipeView.RightItems>
                      <SwipeItems Mode="Reveal">
                        <SwipeItem Text="Edit"
                                   BackgroundColor="#374151"
                                   IsVisible="{Binding CanModify}"
                                   Invoked="OnEditMessageInvoked" />
                        <SwipeItem Text="Delete"
                                   BackgroundColor="#DC2626"
                                   IsVisible="{Binding CanModify}"
                                   Invoked="OnDeleteMessageInvoked" />
                        <SwipeItem Text="Forward"
                                   BackgroundColor="#2563EB"
                                   IsVisible="{Binding CanForward}"
                                   Invoked="OnForwardMessageInvoked" />
                        <SwipeItem Text="Reply"
                                   BackgroundColor="#059669"
                                   IsVisible="{Binding CanReply}"
                                   Invoked="OnReplyToMessageInvoked" />
                      </SwipeItems>
                    </SwipeView.RightItems>

                    <!-- System notice: centered italic line, no bubble chrome -->
                    <Label Text="{Binding Body}"
                           IsVisible="{Binding IsSystem}"
                           FontAttributes="Italic"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center"
                           Margin="0,4" />

                    <!-- Real message bubble -->
                    <Border IsVisible="{Binding IsSystem, Converter={StaticResource InvertBool}}"
                            BackgroundColor="{StaticResource BubbleBg}" Padding="14,10"
                            Stroke="{StaticResource StrokeIdle}" StrokeThickness="1">
                      <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                      </Border.StrokeShape>
                      <Border.Shadow>
                        <Shadow Opacity="0.15" Radius="10" Offset="0,4" />
                      </Border.Shadow>

                      <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout Spacing="8">
                          <Label Text="{Binding Sender}" FontAttributes="Bold" FontSize="12"
                                 TextColor="{StaticResource PrimaryStart}" />
                          <Label Text="{Binding SentAtUtc, StringFormat='{0:HH:mm}'}"
                                 FontSize="11" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                          <Label Text="(edited)" FontSize="11" FontAttributes="Italic"
                                 TextColor="{StaticResource TextSecondary}" IsVisible="{Binding IsEdited}"
                                 VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Border IsVisible="{Binding HasReplyPreview}"
                                Padding="8,6" StrokeThickness="0" BackgroundColor="{StaticResource PanelBg}">
                          <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                          </Border.StrokeShape>
                          <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReplyPreviewTapped" />
                          </Border.GestureRecognizers>
                          <VerticalStackLayout Spacing="1">
                            <Label Text="{Binding ReplyTo.Sender}" FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryStart}" />
                            <Label FontSize="12" LineBreakMode="TailTruncation" MaxLines="1">
                              <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ReplyTo.IsDeleted}" Value="True">
                                  <Setter Property="Text" Value="Original message deleted" />
                                  <Setter Property="FontAttributes" Value="Italic" />
                                  <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding ReplyTo.IsDeleted}" Value="False">
                                  <Setter Property="Text" Value="{Binding ReplyTo.Snippet}" />
                                  <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                                </DataTrigger>
                              </Label.Triggers>
                            </Label>
                          </VerticalStackLayout>
                        </Border>

                        <Label Text="{Binding Body, Converter={StaticResource EmojiDisplay}}"
                               IsVisible="{Binding IsDeleted, Converter={StaticResource InvertBool}}"
                               LineBreakMode="WordWrap"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="14" />
                        <Label Text="Message deleted"
                               IsVisible="{Binding IsDeleted}"
                               FontAttributes="Italic"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}" />

                        <Label Text="↪ Forwarded" FontSize="11" FontAttributes="Italic"
                               TextColor="{StaticResource TextSecondary}" IsVisible="{Binding IsForwarded}" />

                        <Border IsVisible="{Binding ShowAttachmentPlaceholder}"
                                Padding="10,8" StrokeThickness="1"
                                Stroke="{StaticResource StrokeIdle}" BackgroundColor="{StaticResource PanelBg}">
                          <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                          </Border.StrokeShape>
                          <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAttachmentTapped" />
                          </Border.GestureRecognizers>
                          <HorizontalStackLayout Spacing="8">
                            <Label Text="📎" FontSize="16" VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="2">
                              <Label Text="{Binding Attachment.FileName}" FontSize="12"
                                     TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation" />
                              <Label Text="{Binding IsAttachmentLoading, Converter={StaticResource AttachmentStatusText}}"
                                     FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                          </HorizontalStackLayout>
                        </Border>

                        <Image Source="{Binding AttachmentImage}"
                               IsVisible="{Binding ShowAttachmentImage}"
                               Aspect="AspectFit" MaximumHeightRequest="220" HorizontalOptions="Start" />

                        <Border IsVisible="{Binding IsVoiceMessage}"
                                Padding="10,8" StrokeThickness="1"
                                Stroke="{StaticResource StrokeIdle}" BackgroundColor="{StaticResource PanelBg}">
                          <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                          </Border.StrokeShape>
                          <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPlayVoiceMessageTapped" />
                          </Border.GestureRecognizers>
                          <VerticalStackLayout Spacing="4" MinimumWidthRequest="170">
                            <HorizontalStackLayout Spacing="8">
                              <Label FontSize="16" VerticalOptions="Center">
                                <Label.Triggers>
                                  <DataTrigger TargetType="Label" Binding="{Binding IsPlayingVoiceMessage}" Value="True">
                                    <Setter Property="Text" Value="⏸" />
                                  </DataTrigger>
                                  <DataTrigger TargetType="Label" Binding="{Binding IsPlayingVoiceMessage}" Value="False">
                                    <Setter Property="Text" Value="▶" />
                                  </DataTrigger>
                                </Label.Triggers>
                              </Label>
                              <Label Text="Voice message" FontSize="12" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                              <Label Text="{Binding VoiceMessageDurationText}" FontSize="11"
                                     TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"
                                     IsVisible="{Binding IsPlayingVoiceMessage, Converter={StaticResource InvertBool}}" />
                              <Label Text="{Binding IsAttachmentLoading, Converter={StaticResource AttachmentStatusText}}"
                                     FontSize="11" TextColor="{StaticResource TextSecondary}"
                                     IsVisible="{Binding IsAttachmentLoading}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <VerticalStackLayout Spacing="2" IsVisible="{Binding IsPlayingVoiceMessage}">
                              <ProgressBar Progress="{Binding PlaybackProgress}" ProgressColor="{StaticResource PrimaryStart}" />
                              <Label Text="{Binding PlaybackPositionText}" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                          </VerticalStackLayout>
                        </Border>

                        <HorizontalStackLayout Spacing="8">
                          <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Reactions}">
                            <BindableLayout.ItemTemplate>
                              <DataTemplate x:DataType="models:ReactionItem">
                                <Border Padding="7,3" Margin="0,0,6,0" StrokeThickness="1"
                                        Stroke="{StaticResource StrokeIdle}" BackgroundColor="{StaticResource PanelBg}"
                                        ToolTipProperties.Text="{Binding ReactorsText}">
                                  <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                  </Border.StrokeShape>
                                  <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnReactionPillTapped" />
                                  </Border.GestureRecognizers>
                                  <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding Emoji}" FontSize="12" />
                                    <Label Text="{Binding Count}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                  </HorizontalStackLayout>
                                </Border>
                              </DataTemplate>
                            </BindableLayout.ItemTemplate>
                          </FlexLayout>

                          <Button Text="+"
                                  IsVisible="{Binding IsDeleted, Converter={StaticResource InvertBool}}"
                                  Clicked="OnReactButtonClicked"
                                  WidthRequest="28" HeightRequest="24" Padding="0" FontSize="12"
                                  BackgroundColor="{StaticResource PanelBg}" TextColor="{StaticResource TextSecondary}"
                                  CornerRadius="8" />
                        </HorizontalStackLayout>

                        <Label Text="Seen"
                               IsVisible="{Binding SeenByOther}"
                               FontSize="10"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="End" />

                        <Label Text="{Binding GroupSeenText}"
                               IsVisible="{Binding ShowGroupSeenIndicator}"
                               FontSize="10"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="End" />
                      </VerticalStackLayout>
                    </Border>
                  </SwipeView>
                </DataTemplate>
              </CollectionView.ItemTemplate>
            </CollectionView>
          </VerticalStackLayout>
        </ScrollView>
      </Border>

      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
        <Grid ColumnSpacing="10" RowSpacing="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Grid.Row="0" Grid.ColumnSpan="5" IsVisible="{Binding IsReplying}"
                  Padding="10,6" StrokeThickness="0" BackgroundColor="{StaticResource PanelBg}">
            <Border.StrokeShape>
              <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto">
              <VerticalStackLayout Grid.Column="0" Spacing="1">
                <Label Text="{Binding PendingReply.Sender, StringFormat='Replying to {0}'}" FontSize="11"
                       FontAttributes="Bold" TextColor="{StaticResource PrimaryStart}" />
                <Label Text="{Binding PendingReply.Body}" FontSize="12" LineBreakMode="TailTruncation" MaxLines="1"
                       TextColor="{StaticResource TextSecondary}" />
              </VerticalStackLayout>
              <Button Grid.Column="1" Text="✕" Command="{Binding CancelReplyCommand}"
                      WidthRequest="28" HeightRequest="28" Padding="0" FontSize="12"
                      BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}" />
            </Grid>
          </Border>

          <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldBorder}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
              <Label Grid.Column="0" Text="✍️" VerticalOptions="Center" />
              <Entry Grid.Column="1"
                     x:Name="MessageEntry"
                     Placeholder="{Binding MessagePlaceholder}"
                     Text="{Binding OutgoingMessage}"
                     ReturnType="Send"
                     TextColor="{StaticResource TextPrimary}"
                     PlaceholderColor="{StaticResource TextSecondary}"
                     BackgroundColor="Transparent" />
            </Grid>
          </Border>

          <Button Grid.Row="1" Grid.Column="1"
                  Text="📎"
                  Command="{Binding PickAndSendAttachmentCommand}"
                  WidthRequest="44"
                  HeightRequest="48"
                  BackgroundColor="#1F2937"
                  TextColor="#E5E7EB"
                  CornerRadius="12" />

          <Button Grid.Row="1" Grid.Column="2"
                  Text="{Binding IsRecordingVoiceMessage, Converter={StaticResource RecordButtonText}}"
                  Command="{Binding RecordVoiceMessageCommand}"
                  WidthRequest="44"
                  HeightRequest="48"
                  BackgroundColor="{Binding IsRecordingVoiceMessage, Converter={StaticResource RecordButtonBackground}}"
                  TextColor="#E5E7EB"
                  CornerRadius="12" />

          <Button Grid.Row="1" Grid.Column="3"
                  Text="😊"
                  Command="{Binding ShowEmojiPickerCommand}"
                  WidthRequest="44"
                  HeightRequest="48"
                  BackgroundColor="#1F2937"
                  TextColor="#E5E7EB"
                  CornerRadius="12" />

          <Button Grid.Row="1" Grid.Column="4"
                  Text="Send"
                  Command="{Binding SendCommand}"
                  IsEnabled="{Binding CanSend}"
                  Style="{StaticResource PrimaryBtn}"
                  WidthRequest="110" />

          <Label Grid.Row="2" Grid.ColumnSpan="5"
                  Text="{Binding CharacterCounterText}"
                  HorizontalOptions="End"
                  FontSize="12"
                  Opacity="0.85"
                  FontAttributes="Italic"
                  TextColor="{DynamicResource TextSecondary}" />

          <Label Grid.Row="2" Grid.ColumnSpan="5"
                 Text="{Binding TypingUser, StringFormat='{0} is typing…'}"
                 IsVisible="{Binding IsPeerTyping}"
                 FontAttributes="Italic"
                 FontSize="12"
                 TextColor="{StaticResource TextSecondary}"
                 Margin="6,6,0,0" />

          <Label Grid.Row="2" Grid.ColumnSpan="5"
                 Text="{Binding RecordingUser, StringFormat='🎤 {0} is recording a voice message…'}"
                 IsVisible="{Binding IsPeerRecordingVoiceMessage}"
                 FontAttributes="Italic"
                 FontSize="12"
                 TextColor="{StaticResource TextSecondary}"
                 Margin="6,6,0,0" />
        </Grid>
      </Border>
    </Grid>

    <!-- RIGHT: People -->
    <Border Grid.Column="2" Style="{StaticResource Card}">
      <VerticalStackLayout Spacing="0">
        <Border Padding="20,22" StrokeThickness="0" Background="{StaticResource HeaderBrush}">
          <VerticalStackLayout Spacing="14">
            <Label Text="{Binding User, StringFormat='👤 {0}'}"
                   FontSize="16" FontAttributes="Bold" TextColor="White" />
            <Border BackgroundColor="White" Padding="10,8" StrokeThickness="0">
              <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
              </Border.StrokeShape>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Grid.Column="0" Text="Status:" VerticalOptions="Center" TextColor="#374151" FontSize="14" FontAttributes="Bold" />
                <Picker Grid.Column="1"
                        ItemsSource="{Binding StatusOptions}"
                        SelectedItem="{Binding MyStatus}"
                        ItemDisplayBinding="{Binding ., x:DataType=models:PresenceStatus}"
                        TextColor="#374151"
                        FontSize="14"
                        BackgroundColor="Transparent" />
              </Grid>
            </Border>
          </VerticalStackLayout>
        </Border>

        <VerticalStackLayout Padding="16,16" Spacing="12">
          <Label Text="👥 People" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />

          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Border Grid.Column="0" BackgroundColor="#082638" Padding="10,12" StrokeThickness="0">
              <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
              <VerticalStackLayout Spacing="2">
                <Label Text="{Binding People.Count}" FontSize="18" FontAttributes="Bold" TextColor="#6EE7F9" HorizontalOptions="Center" />
                <Label Text="Total" FontSize="11" TextColor="#8ECDED" HorizontalOptions="Center" />
              </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" BackgroundColor="#052A22" Padding="10,12" StrokeThickness="0">
              <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
              <VerticalStackLayout Spacing="2">
                <Label Text="{Binding OnlineUsers.Count}" FontSize="18" FontAttributes="Bold" TextColor="#34D399" HorizontalOptions="Center" />
                <Label Text="Online" FontSize="11" TextColor="#6EE7C1" HorizontalOptions="Center" />
              </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" BackgroundColor="#1B2432" Padding="10,12" StrokeThickness="0">
              <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
              <VerticalStackLayout Spacing="2">
                <Label Text="{Binding OfflineCount}" FontSize="18" FontAttributes="Bold" TextColor="#9CA3AF" HorizontalOptions="Center" />
                <Label Text="Offline" FontSize="11" TextColor="#9CA3AF" HorizontalOptions="Center" />
              </VerticalStackLayout>
            </Border>
          </Grid>

          <ScrollView>
            <CollectionView x:Name="PeopleList" ItemsSource="{Binding People}" SelectionMode="Single">
              <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:UserPresenceItem">
                  <Border BackgroundColor="{StaticResource PanelBg}" Padding="12,10" Margin="0,0,0,10" StrokeThickness="1" Stroke="{StaticResource StrokeIdle}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <Grid ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <Grid Grid.Column="0" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                        <Border StrokeThickness="0" IsVisible="{Binding HasAvatar}">
                          <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                          <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" WidthRequest="32" HeightRequest="32" />
                        </Border>

                        <Border StrokeThickness="2" Stroke="{StaticResource CardBg}">
                          <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                          <Ellipse WidthRequest="28" HeightRequest="28">
                            <Ellipse.Triggers>
                              <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="{x:Static models:PresenceStatus.Busy}">
                                <Setter Property="Fill" Value="#DC2626" />
                              </DataTrigger>
                              <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="{x:Static models:PresenceStatus.Away}">
                                <Setter Property="Fill" Value="#F59E0B" />
                              </DataTrigger>
                              <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="{x:Static models:PresenceStatus.Online}">
                                <Setter Property="Fill" Value="#10B981" />
                              </DataTrigger>
                              <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="{x:Static models:PresenceStatus.Offline}">
                                <Setter Property="Fill" Value="#6B7280" />
                              </DataTrigger>
                            </Ellipse.Triggers>
                          </Ellipse>
                        </Border>
                      </Grid>

                      <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label FontSize="12" TextColor="{StaticResource TextSecondary}">
                          <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="{x:Static models:PresenceStatus.Busy}">
                              <Setter Property="Text" Value="Busy" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="{x:Static models:PresenceStatus.Away}">
                              <Setter Property="Text" Value="Away" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="{x:Static models:PresenceStatus.Online}">
                              <Setter Property="Text" Value="Online" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="{x:Static models:PresenceStatus.Offline}">
                              <Setter Property="Text" Value="Offline" />
                            </DataTrigger>
                          </Label.Triggers>
                        </Label>
                      </VerticalStackLayout>
                    </Grid>
                  </Border>
                </DataTemplate>
              </CollectionView.ItemTemplate>
            </CollectionView>
          </ScrollView>
        </VerticalStackLayout>
      </VerticalStackLayout>
    </Border>
  </Grid>
</ContentPage>
