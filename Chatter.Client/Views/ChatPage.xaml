<?xml version="1.0" encoding="utf-8"?>
<!--
File: ChatPage.xaml

What this does:
- Purpose: Main chat screen showing the chats list (left), current conversation (middle), and people/status panel (right).
- How: Binds to ChatViewModel with compiled bindings (x:DataType). Message bubbles use EmojiDisplayConverter.
       Deleting a chat is wired via a double-tap gesture handled in code-behind (OnDeleteChatTapped) to avoid BindingContext pitfalls.
       Styles/resources define gradients, cards, pills, and input borders used across the layout.
- Where used: Primary app page (Shell route “ChatPage”) after connecting/logging in; interacts with ChatViewModel commands and observable collections.
-->

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Chatter.Client.ViewModels"
    xmlns:models="clr-namespace:Chatter.Client.Models"
    xmlns:conv="clr-namespace:Chatter.Client.Converters"
    xmlns:controls="clr-namespace:Chatter.Client.Controls"
    xmlns:material="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material"
    xmlns:symbols="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    x:Class="Chatter.Client.Views.ChatPage"
    x:Name="ChatPageRoot"
    x:DataType="vm:ChatViewModel"
    Title="Chat"
    BackgroundColor="{StaticResource ColorBackground}"
    NavigationPage.HasNavigationBar="False">

  <!-- Resources -->
  <ContentPage.Resources>
    <ResourceDictionary>
      <!-- Merged here, not in App.xaml: an Application-level StaticResource crashes natively on
           this MAUI/Windows build when read from a page (see App.xaml's comment) - every page
           merges Theme.xaml itself instead. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Styles/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <conv:EmojiDisplayConverter x:Key="EmojiDisplay" />
      <conv:InvertedBoolConverter x:Key="InvertBool" />
      <conv:AttachmentStatusTextConverter x:Key="AttachmentStatusText" />
      <conv:RecordButtonTextConverter x:Key="RecordButtonText" />
      <conv:RecordButtonBackgroundConverter x:Key="RecordButtonBackground" />
      <conv:PinSwipeItemTextConverter x:Key="PinSwipeItemText" />

      <!-- Message-bubble background: distinct enough from CardBorder's surface tone to be worth
           its own token, but specific to this page so it stays local rather than in Theme.xaml. -->
      <Color x:Key="BubbleBg">#0F1B2E</Color>

      <!-- Panel-header accent gradient - page-specific chrome, kept as a decorative touch the
           same way Login/Register keep their gradient blobs; unaffected by the flat-button
           decision since it's not a button. -->
      <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource ColorPrimaryVariant}" Offset="0.0" />
        <GradientStop Color="{StaticResource ColorPrimary}" Offset="1.0" />
      </LinearGradientBrush>

      <Style TargetType="Border" x:Key="Pill">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background">
          <Setter.Value>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="{StaticResource ColorPrimaryVariant}" Offset="0.0" />
              <GradientStop Color="{StaticResource ColorPrimary}" Offset="1.0" />
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
          <Setter.Value>
            <RoundRectangle CornerRadius="12" />
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </ContentPage.Resources>

  <!-- Layout -->
  <Grid ColumnSpacing="0" RowSpacing="0" Padding="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>

    <!-- Decorative gradients -->
    <Ellipse Grid.ColumnSpan="3" WidthRequest="280" HeightRequest="280" Opacity="0.22"
             HorizontalOptions="Start" VerticalOptions="Start" TranslationX="-120" TranslationY="-120">
      <Ellipse.Fill>
        <RadialGradientBrush Radius="0.9" Center="0.7,0.4">
          <GradientStop Color="{StaticResource ColorPrimaryVariant}" Offset="0" />
          <GradientStop Color="#00000000" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse Grid.ColumnSpan="3" WidthRequest="340" HeightRequest="340" Opacity="0.18"
             HorizontalOptions="End" VerticalOptions="End" TranslationX="80" TranslationY="100">
      <Ellipse.Fill>
        <RadialGradientBrush Radius="1.0" Center="0.3,0.6">
          <GradientStop Color="{StaticResource ColorPrimary}" Offset="0" />
          <GradientStop Color="#00000000" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <!-- LEFT: Chats -->
    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
      <VerticalStackLayout Spacing="0">
        <Border Padding="20,22" StrokeThickness="0" BackgroundColor="{StaticResource ColorSurfaceVariant}">
          <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="6">
              <HorizontalStackLayout Spacing="8">
                <Label Text="{x:Static symbols:MaterialOutlined.Forum}" FontFamily="MaterialSymbolsOutlined" FontSize="20" TextColor="{StaticResource ColorPrimaryVariant}" VerticalOptions="Center" />
                <Label Text="Messages" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurface}" VerticalOptions="Center" />
              </HorizontalStackLayout>
              <Label Text="Your conversations" FontSize="12" TextColor="{StaticResource ColorOnSurfaceVariant}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="{x:Static symbols:MaterialOutlined.Group_add}"
                    FontFamily="MaterialSymbolsOutlined"
                    Command="{Binding CreateGroupChatCommand}"
                    ToolTipProperties.Text="New group"
                    WidthRequest="36" HeightRequest="36" FontSize="18" Padding="0"
                    BackgroundColor="{StaticResource ColorOutline}" TextColor="{StaticResource ColorOnSurface}" CornerRadius="18"
                    VerticalOptions="Start" />
          </Grid>
        </Border>
        <BoxView HeightRequest="1" BackgroundColor="{StaticResource ColorOutline}" />

        <ScrollView Padding="12,14">
          <CollectionView x:Name="ChatsCollection"
                          ItemsSource="{Binding Chats}"
                          SelectionMode="Single"
                          SelectedItem="{Binding SelectedChat, Mode=TwoWay}">
            <CollectionView.ItemTemplate>
              <DataTemplate x:DataType="models:ChatItem">
                <Border BackgroundColor="{StaticResource ColorSurfaceVariant}"
                        Padding="12" Margin="0,0,0,10"
                        StrokeThickness="1" Stroke="{StaticResource ColorOutline}">
                  <!-- Double-tap to delete: handled in code-behind to avoid any BindingContext paths -->
                  <Border.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="2"
                                          Tapped="OnDeleteChatTapped" />
                  </Border.GestureRecognizers>

                  <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                  </Border.StrokeShape>

                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Delete icon (visual) -->
                    <Border Grid.Column="0" WidthRequest="32" HeightRequest="32" BackgroundColor="#251622" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Center">
                      <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                      </Border.StrokeShape>
                      <Label Text="{x:Static symbols:MaterialOutlined.Close}" FontFamily="MaterialSymbolsOutlined" FontSize="16" TextColor="#F87171"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                        <Label.Triggers>
                          <DataTrigger TargetType="Label" Binding="{Binding Id}" Value="Lobby">
                            <Setter Property="IsVisible" Value="False" />
                          </DataTrigger>
                        </Label.Triggers>
                      </Label>
                    </Border>

                    <!-- Chat info -->
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                      <HorizontalStackLayout Spacing="4">
                        <Label Text="{Binding Label}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurface}" LineBreakMode="TailTruncation">
                          <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding Id}" Value="Lobby">
                              <Setter Property="TextColor" Value="{StaticResource ColorPrimaryVariant}" />
                            </DataTrigger>
                          </Label.Triggers>
                        </Label>
                        <Label Text="{x:Static symbols:MaterialOutlined.Notifications_off}" FontFamily="MaterialSymbolsOutlined" FontSize="11" IsVisible="{Binding IsMuted}" VerticalOptions="Center" />
                        <Label Text="{x:Static symbols:MaterialOutlined.Push_pin}" FontFamily="MaterialSymbolsOutlined" FontSize="11" IsVisible="{Binding IsPinned}" VerticalOptions="Center" />
                      </HorizontalStackLayout>
                      <Label Text="Tap to open" FontSize="11" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                    </VerticalStackLayout>

                    <!-- Unread -->
                    <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalOptions="Center" IsVisible="True">
                      <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding Unread}" Value="0">
                          <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                      </Border.Triggers>
                      <Label Text="{Binding Unread}" FontAttributes="Bold" FontSize="11" TextColor="White" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>
        </ScrollView>
      </VerticalStackLayout>
    </Border>

    <!-- MIDDLE: Conversation -->
    <Grid Grid.Column="1" Margin="0" RowSpacing="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="20,16" Margin="0,0,12,12">
        <VerticalStackLayout Spacing="10">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeThickness="0" Background="{StaticResource HeaderBrush}">
              <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
              </Border.StrokeShape>
              <Label Text="{x:Static symbols:MaterialOutlined.Forum}" FontFamily="MaterialSymbolsOutlined" FontSize="18" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"
                     HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
              <HorizontalStackLayout Spacing="6">
                <Label Text="{Binding SelectedChat.Label, FallbackValue='Select a chat'}"
                       FontSize="16" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurface}" />
                <Label Text="{x:Static symbols:MaterialOutlined.Notifications_off}" FontFamily="MaterialSymbolsOutlined" FontSize="13" IsVisible="{Binding SelectedChat.IsMuted, FallbackValue=False}" VerticalOptions="Center" />
              </HorizontalStackLayout>
              <HorizontalStackLayout Spacing="8">
                <Label Text="Messages" FontSize="12" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                <Border Style="{StaticResource Pill}" Padding="8,2" VerticalOptions="Center">
                  <Label Text="{Binding CurrentChatMessages.Count, StringFormat='{0}'}"
                         FontSize="11" FontAttributes="Bold" TextColor="White" />
                </Border>
              </HorizontalStackLayout>
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="{x:Static symbols:MaterialOutlined.Call}"
                    FontFamily="MaterialSymbolsOutlined"
                    Command="{Binding StartCallCommand}"
                    IsVisible="{Binding IsSelectedChatDm}"
                    WidthRequest="40" HeightRequest="40" FontSize="18" Padding="0"
                    BackgroundColor="{StaticResource ColorSurfaceVariant}" TextColor="{StaticResource ColorOnSurface}" CornerRadius="20" />
            <Button Grid.Column="3" Text="{x:Static symbols:MaterialOutlined.Search}"
                    FontFamily="MaterialSymbolsOutlined"
                    Command="{Binding ToggleSearchCommand}"
                    WidthRequest="40" HeightRequest="40" FontSize="18" Padding="0"
                    BackgroundColor="{StaticResource ColorSurfaceVariant}" TextColor="{StaticResource ColorOnSurface}" CornerRadius="20" />
            <!-- ManageChatCommand no-ops for Lobby/drafts/no selection, so this can always be visible. -->
            <Button Grid.Column="4" Text="{x:Static symbols:MaterialOutlined.More_vert}"
                    FontFamily="MaterialSymbolsOutlined"
                    Command="{Binding ManageChatCommand}"
                    WidthRequest="40" HeightRequest="40" FontSize="18" Padding="0"
                    BackgroundColor="{StaticResource ColorSurfaceVariant}" TextColor="{StaticResource ColorOnSurface}" CornerRadius="20" />
          </Grid>

          <CollectionView IsVisible="{Binding HasPinnedMessages}"
                          ItemsSource="{Binding PinnedMessages}" HeightRequest="40"
                          ItemsLayout="HorizontalList">
            <CollectionView.ItemTemplate>
              <DataTemplate x:DataType="models:ChatMessageItem">
                <Border Padding="8,4" Margin="0,0,6,0" StrokeThickness="1"
                        Stroke="{StaticResource ColorOutline}" BackgroundColor="{StaticResource ColorSurfaceVariant}">
                  <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                  <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPinnedMessageTapped" />
                  </Border.GestureRecognizers>
                  <HorizontalStackLayout Spacing="6">
                    <Label Text="{x:Static symbols:MaterialOutlined.Push_pin}" FontFamily="MaterialSymbolsOutlined" FontSize="11" VerticalOptions="Center" />
                    <Label Text="{Binding Sender}" FontSize="11" FontAttributes="Bold"
                           TextColor="{StaticResource ColorPrimaryVariant}" VerticalOptions="Center" />
                    <Label Text="{Binding Body}" FontSize="11" LineBreakMode="TailTruncation" MaxLines="1"
                           WidthRequest="140" TextColor="{StaticResource ColorOnSurfaceVariant}" VerticalOptions="Center" />
                  </HorizontalStackLayout>
                </Border>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>

          <Grid IsVisible="{Binding IsSearching}" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <material:TextField Grid.Column="0"
                   Title="Search this chat"
                   Text="{Binding SearchQuery}" />
            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsSearchRunning}"
                   IsVisible="{Binding IsSearchRunning}"
                   Color="{StaticResource ColorPrimary}" VerticalOptions="Center" />
          </Grid>

          <CollectionView IsVisible="{Binding IsSearching}" ItemsSource="{Binding SearchResults}" MaximumHeightRequest="260">
            <CollectionView.ItemTemplate>
              <DataTemplate x:DataType="models:ChatMessageItem">
                <Border Padding="10,8" Margin="0,0,0,6" StrokeThickness="1"
                        Stroke="{StaticResource ColorOutline}" BackgroundColor="{StaticResource ColorSurfaceVariant}">
                  <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                  <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSearchResultTapped" />
                  </Border.GestureRecognizers>
                  <VerticalStackLayout Spacing="2">
                    <HorizontalStackLayout Spacing="6">
                      <Label Text="{Binding Sender}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource ColorPrimaryVariant}" />
                      <Label Text="{Binding SentAtUtc, StringFormat='{0:g}'}" FontSize="11" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding Body}" FontSize="13" LineBreakMode="TailTruncation" MaxLines="2" TextColor="{StaticResource ColorOnSurface}" />
                  </VerticalStackLayout>
                </Border>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>
        </VerticalStackLayout>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,0,12,12">
        <ScrollView>
          <VerticalStackLayout Spacing="10">
            <Button Text="Load earlier messages"
                    Command="{Binding LoadMoreHistoryCommand}"
                    IsVisible="{Binding CanLoadMoreHistory}"
                    BackgroundColor="#1F2937"
                    TextColor="{StaticResource ColorOnSurfaceVariant}"
                    FontSize="12"
                    HeightRequest="36"
                    CornerRadius="10"
                    HorizontalOptions="Center" />

            <CollectionView x:Name="MessagesList" ItemsSource="{Binding CurrentChatMessages}">
              <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
              </CollectionView.ItemsLayout>
              <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessageItem">
                  <SwipeView>
                    <SwipeView.RightItems>
                      <SwipeItems Mode="Reveal">
                        <SwipeItem Text="Edit"
                                   BackgroundColor="#374151"
                                   IsVisible="{Binding CanModify}"
                                   Invoked="OnEditMessageInvoked">
                          <SwipeItem.IconImageSource>
                            <FontImageSource FontFamily="MaterialSymbolsOutlined" Glyph="{x:Static symbols:MaterialOutlined.Edit}" Color="White" Size="18" />
                          </SwipeItem.IconImageSource>
                        </SwipeItem>
                        <SwipeItem Text="Delete"
                                   BackgroundColor="#DC2626"
                                   IsVisible="{Binding CanModify}"
                                   Invoked="OnDeleteMessageInvoked">
                          <SwipeItem.IconImageSource>
                            <FontImageSource FontFamily="MaterialSymbolsOutlined" Glyph="{x:Static symbols:MaterialOutlined.Delete}" Color="White" Size="18" />
                          </SwipeItem.IconImageSource>
                        </SwipeItem>
                        <SwipeItem Text="Forward"
                                   BackgroundColor="#2563EB"
                                   IsVisible="{Binding CanForward}"
                                   Invoked="OnForwardMessageInvoked">
                          <SwipeItem.IconImageSource>
                            <FontImageSource FontFamily="MaterialSymbolsOutlined" Glyph="{x:Static symbols:MaterialOutlined.Forward}" Color="White" Size="18" />
                          </SwipeItem.IconImageSource>
                        </SwipeItem>
                        <SwipeItem Text="Reply"
                                   BackgroundColor="#059669"
                                   IsVisible="{Binding CanReply}"
                                   Invoked="OnReplyToMessageInvoked">
                          <SwipeItem.IconImageSource>
                            <FontImageSource FontFamily="MaterialSymbolsOutlined" Glyph="{x:Static symbols:MaterialOutlined.Reply}" Color="White" Size="18" />
                          </SwipeItem.IconImageSource>
                        </SwipeItem>
                        <SwipeItem Text="{Binding IsPinned, Converter={StaticResource PinSwipeItemText}}"
                                   BackgroundColor="#B45309"
                                   IsVisible="{Binding CanPin}"
                                   Invoked="OnTogglePinInvoked">
                          <SwipeItem.IconImageSource>
                            <FontImageSource FontFamily="MaterialSymbolsOutlined" Glyph="{x:Static symbols:MaterialOutlined.Push_pin}" Color="White" Size="18" />
                          </SwipeItem.IconImageSource>
                        </SwipeItem>
                      </SwipeItems>
                    </SwipeView.RightItems>

                    <!-- System notice: centered italic line, no bubble chrome -->
                    <Label Text="{Binding Body}"
                           IsVisible="{Binding IsSystem}"
                           FontAttributes="Italic"
                           FontSize="12"
                           TextColor="{StaticResource ColorOnSurfaceVariant}"
                           HorizontalOptions="Center"
                           Margin="0,4" />

                    <!-- Real message bubble -->
                    <Border IsVisible="{Binding IsSystem, Converter={StaticResource InvertBool}}"
                            BackgroundColor="{StaticResource BubbleBg}" Padding="14,10"
                            Stroke="{StaticResource ColorOutline}" StrokeThickness="1">
                      <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                      </Border.StrokeShape>
                      <Border.Shadow>
                        <Shadow Opacity="0.15" Radius="10" Offset="0,4" />
                      </Border.Shadow>

                      <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout Spacing="8">
                          <Label Text="{Binding Sender}" FontAttributes="Bold" FontSize="12"
                                 TextColor="{StaticResource ColorPrimaryVariant}" />
                          <Label Text="{Binding SentAtUtc, StringFormat='{0:HH:mm}'}"
                                 FontSize="11" TextColor="{StaticResource ColorOnSurfaceVariant}" VerticalOptions="Center" />
                          <Label Text="(edited)" FontSize="11" FontAttributes="Italic"
                                 TextColor="{StaticResource ColorOnSurfaceVariant}" IsVisible="{Binding IsEdited}"
                                 VerticalOptions="Center">
                            <Label.GestureRecognizers>
                              <TapGestureRecognizer Tapped="OnViewEditHistoryTapped" />
                            </Label.GestureRecognizers>
                          </Label>
                          <Label Text="{x:Static symbols:MaterialOutlined.Push_pin}" FontFamily="MaterialSymbolsOutlined" FontSize="11" IsVisible="{Binding IsPinned}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Border IsVisible="{Binding HasReplyPreview}"
                                Padding="8,6" StrokeThickness="0" BackgroundColor="{StaticResource ColorSurfaceVariant}">
                          <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                          </Border.StrokeShape>
                          <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReplyPreviewTapped" />
                          </Border.GestureRecognizers>
                          <VerticalStackLayout Spacing="1">
                            <Label Text="{Binding ReplyTo.Sender}" FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource ColorPrimaryVariant}" />
                            <Label FontSize="12" LineBreakMode="TailTruncation" MaxLines="1">
                              <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ReplyTo.IsDeleted}" Value="True">
                                  <Setter Property="Text" Value="Original message deleted" />
                                  <Setter Property="FontAttributes" Value="Italic" />
                                  <Setter Property="TextColor" Value="{StaticResource ColorOnSurfaceVariant}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding ReplyTo.IsDeleted}" Value="False">
                                  <Setter Property="Text" Value="{Binding ReplyTo.Snippet}" />
                                  <Setter Property="TextColor" Value="{StaticResource ColorOnSurface}" />
                                </DataTrigger>
                              </Label.Triggers>
                            </Label>
                          </VerticalStackLayout>
                        </Border>

                        <Label Text="{Binding Body, Converter={StaticResource EmojiDisplay}}"
                               IsVisible="{Binding IsDeleted, Converter={StaticResource InvertBool}}"
                               LineBreakMode="WordWrap"
                               TextColor="{StaticResource ColorOnSurface}"
                               FontSize="14" />
                        <Label Text="Message deleted"
                               IsVisible="{Binding IsDeleted}"
                               FontAttributes="Italic"
                               FontSize="13"
                               TextColor="{StaticResource ColorOnSurfaceVariant}" />

                        <Label Text="↪ Forwarded" FontSize="11" FontAttributes="Italic"
                               TextColor="{StaticResource ColorOnSurfaceVariant}" IsVisible="{Binding IsForwarded}" />

                        <Border IsVisible="{Binding HasLinkPreview}"
                                Padding="0" StrokeThickness="1"
                                Stroke="{StaticResource ColorOutline}" BackgroundColor="{StaticResource ColorSurfaceVariant}">
                          <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                          </Border.StrokeShape>
                          <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLinkPreviewTapped" />
                          </Border.GestureRecognizers>
                          <VerticalStackLayout Spacing="0">
                            <Image Source="{Binding LinkPreview.ImageUrl}" Aspect="AspectFill"
                                   HeightRequest="120"
                                   IsVisible="{Binding HasLinkPreviewImage}" />
                            <VerticalStackLayout Spacing="2" Padding="10,8">
                              <Label Text="{Binding LinkPreview.Title}" FontSize="12" FontAttributes="Bold"
                                     LineBreakMode="TailTruncation" MaxLines="1" TextColor="{StaticResource ColorOnSurface}" />
                              <Label Text="{Binding LinkPreview.Description}" FontSize="11"
                                     LineBreakMode="TailTruncation" MaxLines="2" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                              <Label Text="{Binding LinkPreview.Url}" FontSize="10"
                                     LineBreakMode="TailTruncation" MaxLines="1" TextColor="{StaticResource ColorPrimaryVariant}" />
                            </VerticalStackLayout>
                          </VerticalStackLayout>
                        </Border>

                        <Border IsVisible="{Binding ShowAttachmentPlaceholder}"
                                Padding="10,8" StrokeThickness="1"
                                Stroke="{StaticResource ColorOutline}" BackgroundColor="{StaticResource ColorSurfaceVariant}">
                          <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                          </Border.StrokeShape>
                          <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAttachmentTapped" />
                          </Border.GestureRecognizers>
                          <HorizontalStackLayout Spacing="8">
                            <Label Text="{x:Static symbols:MaterialOutlined.Attach_file}" FontFamily="MaterialSymbolsOutlined" FontSize="16" VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="2">
                              <Label Text="{Binding Attachment.FileName}" FontSize="12"
                                     TextColor="{StaticResource ColorOnSurface}" LineBreakMode="TailTruncation" />
                              <Label Text="{Binding IsAttachmentLoading, Converter={StaticResource AttachmentStatusText}}"
                                     FontSize="11" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                            </VerticalStackLayout>
                          </HorizontalStackLayout>
                        </Border>

                        <Image Source="{Binding AttachmentImage}"
                               IsVisible="{Binding ShowAttachmentImage}"
                               Aspect="AspectFit" MaximumHeightRequest="220" HorizontalOptions="Start" />

                        <Border IsVisible="{Binding IsVoiceMessage}"
                                Padding="10,8" StrokeThickness="1"
                                Stroke="{StaticResource ColorOutline}" BackgroundColor="{StaticResource ColorSurfaceVariant}">
                          <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                          </Border.StrokeShape>
                          <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPlayVoiceMessageTapped" />
                          </Border.GestureRecognizers>
                          <VerticalStackLayout Spacing="4" MinimumWidthRequest="170">
                            <HorizontalStackLayout Spacing="8">
                              <Label FontFamily="MaterialSymbolsOutlined" FontSize="16" VerticalOptions="Center">
                                <Label.Triggers>
                                  <DataTrigger TargetType="Label" Binding="{Binding IsPlayingVoiceMessage}" Value="True">
                                    <Setter Property="Text" Value="{x:Static symbols:MaterialOutlined.Pause}" />
                                  </DataTrigger>
                                  <DataTrigger TargetType="Label" Binding="{Binding IsPlayingVoiceMessage}" Value="False">
                                    <Setter Property="Text" Value="{x:Static symbols:MaterialOutlined.Play_arrow}" />
                                  </DataTrigger>
                                </Label.Triggers>
                              </Label>
                              <Label Text="Voice message" FontSize="12" TextColor="{StaticResource ColorOnSurface}" VerticalOptions="Center" />
                              <Label Text="{Binding VoiceMessageDurationText}" FontSize="11"
                                     TextColor="{StaticResource ColorOnSurfaceVariant}" VerticalOptions="Center"
                                     IsVisible="{Binding IsPlayingVoiceMessage, Converter={StaticResource InvertBool}}" />
                              <Label Text="{Binding IsAttachmentLoading, Converter={StaticResource AttachmentStatusText}}"
                                     FontSize="11" TextColor="{StaticResource ColorOnSurfaceVariant}"
                                     IsVisible="{Binding IsAttachmentLoading}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <controls:WaveformView MessageItem="{Binding .}" HeightRequest="28"
                                                   IsVisible="{Binding HasWaveform}" />
                            <Label Text="{Binding PlaybackPositionText}" FontSize="10" TextColor="{StaticResource ColorOnSurfaceVariant}"
                                   IsVisible="{Binding IsPlayingVoiceMessage}" />
                          </VerticalStackLayout>
                        </Border>

                        <Border IsVisible="{Binding IsVideoAttachment}"
                                Padding="10,8" StrokeThickness="1"
                                Stroke="{StaticResource ColorOutline}" BackgroundColor="{StaticResource ColorSurfaceVariant}">
                          <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                          </Border.StrokeShape>
                          <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenExternalAttachmentTapped" />
                          </Border.GestureRecognizers>
                          <HorizontalStackLayout Spacing="8">
                            <Label Text="{x:Static symbols:MaterialOutlined.Videocam}" FontFamily="MaterialSymbolsOutlined" FontSize="16" VerticalOptions="Center" />
                            <Label Text="Video - tap to play" FontSize="12" TextColor="{StaticResource ColorOnSurface}" VerticalOptions="Center" />
                            <Label Text="{Binding VideoDurationText}" FontSize="11"
                                   TextColor="{StaticResource ColorOnSurfaceVariant}" VerticalOptions="Center" />
                            <Label Text="{Binding IsAttachmentLoading, Converter={StaticResource AttachmentStatusText}}"
                                   FontSize="11" TextColor="{StaticResource ColorOnSurfaceVariant}"
                                   IsVisible="{Binding IsAttachmentLoading}" VerticalOptions="Center" />
                          </HorizontalStackLayout>
                        </Border>

                        <Border IsVisible="{Binding IsDocumentAttachment}"
                                Padding="10,8" StrokeThickness="1"
                                Stroke="{StaticResource ColorOutline}" BackgroundColor="{StaticResource ColorSurfaceVariant}">
                          <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                          </Border.StrokeShape>
                          <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenExternalAttachmentTapped" />
                          </Border.GestureRecognizers>
                          <HorizontalStackLayout Spacing="8">
                            <Label Text="{x:Static symbols:MaterialOutlined.Description}" FontFamily="MaterialSymbolsOutlined" FontSize="16" VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="1">
                              <Label Text="{Binding Attachment.FileName}" FontSize="12"
                                     TextColor="{StaticResource ColorOnSurface}" LineBreakMode="TailTruncation" />
                              <Label Text="{Binding DocumentSizeText}" FontSize="11" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                            </VerticalStackLayout>
                            <Label Text="{Binding IsAttachmentLoading, Converter={StaticResource AttachmentStatusText}}"
                                   FontSize="11" TextColor="{StaticResource ColorOnSurfaceVariant}"
                                   IsVisible="{Binding IsAttachmentLoading}" VerticalOptions="Center" />
                          </HorizontalStackLayout>
                        </Border>

                        <HorizontalStackLayout Spacing="8">
                          <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Reactions}">
                            <BindableLayout.ItemTemplate>
                              <DataTemplate x:DataType="models:ReactionItem">
                                <Border Padding="7,3" Margin="0,0,6,0" StrokeThickness="1"
                                        Stroke="{StaticResource ColorOutline}" BackgroundColor="{StaticResource ColorSurfaceVariant}"
                                        ToolTipProperties.Text="{Binding ReactorsText}">
                                  <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                  </Border.StrokeShape>
                                  <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnReactionPillTapped" />
                                  </Border.GestureRecognizers>
                                  <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding Emoji}" FontSize="12" />
                                    <Label Text="{Binding Count}" FontSize="11" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                                  </HorizontalStackLayout>
                                </Border>
                              </DataTemplate>
                            </BindableLayout.ItemTemplate>
                          </FlexLayout>

                          <Button Text="+"
                                  IsVisible="{Binding IsDeleted, Converter={StaticResource InvertBool}}"
                                  Clicked="OnReactButtonClicked"
                                  WidthRequest="28" HeightRequest="24" Padding="0" FontSize="12"
                                  BackgroundColor="{StaticResource ColorSurfaceVariant}" TextColor="{StaticResource ColorOnSurfaceVariant}"
                                  CornerRadius="8" />
                        </HorizontalStackLayout>

                        <Label Text="Seen"
                               IsVisible="{Binding SeenByOther}"
                               FontSize="10"
                               TextColor="{StaticResource ColorOnSurfaceVariant}"
                               HorizontalOptions="End" />

                        <Label Text="{Binding GroupSeenText}"
                               IsVisible="{Binding ShowGroupSeenIndicator}"
                               FontSize="10"
                               TextColor="{StaticResource ColorOnSurfaceVariant}"
                               HorizontalOptions="End" />
                      </VerticalStackLayout>
                    </Border>
                  </SwipeView>
                </DataTemplate>
              </CollectionView.ItemTemplate>
            </CollectionView>
          </VerticalStackLayout>
        </ScrollView>
      </Border>

      <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,12,0">
        <Grid ColumnSpacing="10" RowSpacing="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Grid.Row="0" Grid.ColumnSpan="6" IsVisible="{Binding IsReplying}"
                  Padding="10,6" StrokeThickness="0" BackgroundColor="{StaticResource ColorSurfaceVariant}">
            <Border.StrokeShape>
              <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto">
              <VerticalStackLayout Grid.Column="0" Spacing="1">
                <Label Text="{Binding PendingReply.Sender, StringFormat='Replying to {0}'}" FontSize="11"
                       FontAttributes="Bold" TextColor="{StaticResource ColorPrimaryVariant}" />
                <Label Text="{Binding PendingReply.Body}" FontSize="12" LineBreakMode="TailTruncation" MaxLines="1"
                       TextColor="{StaticResource ColorOnSurfaceVariant}" />
              </VerticalStackLayout>
              <Button Grid.Column="1" Text="{x:Static symbols:MaterialOutlined.Close}" FontFamily="MaterialSymbolsOutlined" Command="{Binding CancelReplyCommand}"
                      WidthRequest="28" HeightRequest="28" Padding="0" FontSize="14"
                      BackgroundColor="Transparent" TextColor="{StaticResource ColorOnSurfaceVariant}" />
            </Grid>
          </Border>

          <material:TextField Grid.Row="1" Grid.Column="0"
                 x:Name="MessageEntry"
                 Title="{Binding MessagePlaceholder}"
                 Text="{Binding OutgoingMessage}"
                 ReturnType="Send" />

          <Button Grid.Row="1" Grid.Column="1"
                  Text="{x:Static symbols:MaterialOutlined.Attach_file}"
                  FontFamily="MaterialSymbolsOutlined"
                  Command="{Binding PickAndSendAttachmentCommand}"
                  WidthRequest="44"
                  HeightRequest="48"
                  BackgroundColor="{StaticResource ColorSurfaceVariant}"
                  TextColor="{StaticResource ColorOnSurface}"
                  CornerRadius="12" />

          <Button Grid.Row="1" Grid.Column="2"
                  Text="{Binding IsRecordingVoiceMessage, Converter={StaticResource RecordButtonText}}"
                  FontFamily="MaterialSymbolsOutlined"
                  Command="{Binding RecordVoiceMessageCommand}"
                  WidthRequest="44"
                  HeightRequest="48"
                  BackgroundColor="{Binding IsRecordingVoiceMessage, Converter={StaticResource RecordButtonBackground}}"
                  TextColor="{StaticResource ColorOnSurface}"
                  CornerRadius="12" />

          <Button Grid.Row="1" Grid.Column="3"
                  Text="{x:Static symbols:MaterialOutlined.Videocam}"
                  FontFamily="MaterialSymbolsOutlined"
                  Command="{Binding PickAndSendVideoCommand}"
                  WidthRequest="44"
                  HeightRequest="48"
                  BackgroundColor="{StaticResource ColorSurfaceVariant}"
                  TextColor="{StaticResource ColorOnSurface}"
                  CornerRadius="12" />

          <Button Grid.Row="1" Grid.Column="4"
                  Text="{x:Static symbols:MaterialOutlined.Mood}"
                  FontFamily="MaterialSymbolsOutlined"
                  Command="{Binding ShowEmojiPickerCommand}"
                  WidthRequest="44"
                  HeightRequest="48"
                  BackgroundColor="{StaticResource ColorSurfaceVariant}"
                  TextColor="{StaticResource ColorOnSurface}"
                  CornerRadius="12" />

          <Button Grid.Row="1" Grid.Column="5"
                  Text="Send"
                  Command="{Binding SendCommand}"
                  IsEnabled="{Binding CanSend}"
                  Style="{StaticResource PrimaryButton}"
                  WidthRequest="110" />

          <Label Grid.Row="2" Grid.ColumnSpan="6"
                  Text="{Binding CharacterCounterText}"
                  HorizontalOptions="End"
                  FontSize="12"
                  Opacity="0.85"
                  FontAttributes="Italic"
                  TextColor="{DynamicResource ColorOnSurfaceVariant}" />

          <Label Grid.Row="2" Grid.ColumnSpan="6"
                 Text="{Binding TypingUser, StringFormat='{0} is typing…'}"
                 IsVisible="{Binding IsPeerTyping}"
                 FontAttributes="Italic"
                 FontSize="12"
                 TextColor="{StaticResource ColorOnSurfaceVariant}"
                 Margin="6,6,0,0" />

          <Label Grid.Row="2" Grid.ColumnSpan="6"
                 Text="{Binding RecordingUser, StringFormat='🎤 {0} is recording a voice message…'}"
                 IsVisible="{Binding IsPeerRecordingVoiceMessage}"
                 FontAttributes="Italic"
                 FontSize="12"
                 TextColor="{StaticResource ColorOnSurfaceVariant}"
                 Margin="6,6,0,0" />
        </Grid>
      </Border>
    </Grid>

    <!-- RIGHT: People -->
    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
      <VerticalStackLayout Spacing="0">
        <Border Padding="20,22" StrokeThickness="0" BackgroundColor="{StaticResource ColorSurfaceVariant}">
          <VerticalStackLayout Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <HorizontalStackLayout Grid.Column="0" Spacing="8">
                <Label Text="{x:Static symbols:MaterialOutlined.Person}" FontFamily="MaterialSymbolsOutlined" FontSize="16" TextColor="{StaticResource ColorPrimaryVariant}" VerticalOptions="Center" />
                <Label Text="{Binding User}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurface}" VerticalOptions="Center" />
              </HorizontalStackLayout>
              <Button Grid.Column="1" Text="{x:Static symbols:MaterialOutlined.Settings}"
                      FontFamily="MaterialSymbolsOutlined"
                      Clicked="OnSettingsClicked"
                      ToolTipProperties.Text="Settings"
                      WidthRequest="32" HeightRequest="32" FontSize="16" Padding="0"
                      BackgroundColor="{StaticResource ColorOutline}" TextColor="{StaticResource ColorOnSurface}" CornerRadius="16"
                      VerticalOptions="Center" />
            </Grid>
            <Border BackgroundColor="{StaticResource ColorSurface}" Padding="12,10" StrokeThickness="1" Stroke="{StaticResource ColorOutline}">
              <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
              </Border.StrokeShape>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Ellipse Grid.Column="0" WidthRequest="10" HeightRequest="10" VerticalOptions="Center">
                  <Ellipse.Triggers>
                    <DataTrigger TargetType="Ellipse" Binding="{Binding MyStatus}" Value="{x:Static models:PresenceStatus.Busy}">
                      <Setter Property="Fill" Value="#DC2626" />
                    </DataTrigger>
                    <DataTrigger TargetType="Ellipse" Binding="{Binding MyStatus}" Value="{x:Static models:PresenceStatus.Away}">
                      <Setter Property="Fill" Value="#F59E0B" />
                    </DataTrigger>
                    <DataTrigger TargetType="Ellipse" Binding="{Binding MyStatus}" Value="{x:Static models:PresenceStatus.Online}">
                      <Setter Property="Fill" Value="#10B981" />
                    </DataTrigger>
                    <DataTrigger TargetType="Ellipse" Binding="{Binding MyStatus}" Value="{x:Static models:PresenceStatus.Offline}">
                      <Setter Property="Fill" Value="#6B7280" />
                    </DataTrigger>
                  </Ellipse.Triggers>
                </Ellipse>
                <Picker Grid.Column="1"
                        ItemsSource="{Binding StatusOptions}"
                        SelectedItem="{Binding MyStatus}"
                        ItemDisplayBinding="{Binding ., x:DataType=models:PresenceStatus}"
                        TextColor="{StaticResource ColorOnSurface}"
                        FontSize="14"
                        FontAttributes="Bold"
                        BackgroundColor="Transparent" />
                <Label Grid.Column="2" Text="{x:Static symbols:MaterialOutlined.Expand_more}"
                       FontFamily="MaterialSymbolsOutlined" FontSize="16"
                       TextColor="{StaticResource ColorOnSurfaceVariant}" VerticalOptions="Center" />
              </Grid>
            </Border>
          </VerticalStackLayout>
        </Border>
        <BoxView HeightRequest="1" BackgroundColor="{StaticResource ColorOutline}" />

        <VerticalStackLayout Padding="16,16" Spacing="12">
          <HorizontalStackLayout Spacing="8">
            <Label Text="{x:Static symbols:MaterialOutlined.Group}" FontFamily="MaterialSymbolsOutlined" FontSize="16" TextColor="{StaticResource ColorOnSurface}" VerticalOptions="Center" />
            <Label Text="People" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurface}" VerticalOptions="Center" />
          </HorizontalStackLayout>

          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Border Grid.Column="0" BackgroundColor="#082638" Padding="10,12" StrokeThickness="0">
              <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
              <VerticalStackLayout Spacing="2">
                <Label Text="{Binding People.Count}" FontSize="18" FontAttributes="Bold" TextColor="#6EE7F9" HorizontalOptions="Center" />
                <Label Text="Total" FontSize="11" TextColor="#8ECDED" HorizontalOptions="Center" />
              </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" BackgroundColor="#052A22" Padding="10,12" StrokeThickness="0">
              <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
              <VerticalStackLayout Spacing="2">
                <Label Text="{Binding OnlineUsers.Count}" FontSize="18" FontAttributes="Bold" TextColor="#34D399" HorizontalOptions="Center" />
                <Label Text="Online" FontSize="11" TextColor="#6EE7C1" HorizontalOptions="Center" />
              </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" BackgroundColor="#1B2432" Padding="10,12" StrokeThickness="0">
              <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
              <VerticalStackLayout Spacing="2">
                <Label Text="{Binding OfflineCount}" FontSize="18" FontAttributes="Bold" TextColor="#9CA3AF" HorizontalOptions="Center" />
                <Label Text="Offline" FontSize="11" TextColor="#9CA3AF" HorizontalOptions="Center" />
              </VerticalStackLayout>
            </Border>
          </Grid>

          <ScrollView>
            <CollectionView x:Name="PeopleList" ItemsSource="{Binding People}" SelectionMode="Single">
              <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:UserPresenceItem">
                  <Border BackgroundColor="{StaticResource ColorSurfaceVariant}" Padding="12,10" Margin="0,0,0,10" StrokeThickness="1" Stroke="{StaticResource ColorOutline}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <Grid ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <Grid Grid.Column="0" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                        <Border StrokeThickness="0" IsVisible="{Binding HasAvatar}">
                          <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                          <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" WidthRequest="32" HeightRequest="32" />
                        </Border>

                        <Border StrokeThickness="2" Stroke="{StaticResource ColorSurface}">
                          <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                          <Ellipse WidthRequest="28" HeightRequest="28">
                            <Ellipse.Triggers>
                              <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="{x:Static models:PresenceStatus.Busy}">
                                <Setter Property="Fill" Value="#DC2626" />
                              </DataTrigger>
                              <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="{x:Static models:PresenceStatus.Away}">
                                <Setter Property="Fill" Value="#F59E0B" />
                              </DataTrigger>
                              <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="{x:Static models:PresenceStatus.Online}">
                                <Setter Property="Fill" Value="#10B981" />
                              </DataTrigger>
                              <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="{x:Static models:PresenceStatus.Offline}">
                                <Setter Property="Fill" Value="#6B7280" />
                              </DataTrigger>
                            </Ellipse.Triggers>
                          </Ellipse>
                        </Border>
                      </Grid>

                      <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurface}" />
                        <Label FontSize="12" TextColor="{StaticResource ColorOnSurfaceVariant}">
                          <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="{x:Static models:PresenceStatus.Busy}">
                              <Setter Property="Text" Value="Busy" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="{x:Static models:PresenceStatus.Away}">
                              <Setter Property="Text" Value="Away" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="{x:Static models:PresenceStatus.Online}">
                              <Setter Property="Text" Value="Online" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="{x:Static models:PresenceStatus.Offline}">
                              <Setter Property="Text" Value="Offline" />
                            </DataTrigger>
                          </Label.Triggers>
                        </Label>
                      </VerticalStackLayout>
                    </Grid>
                  </Border>
                </DataTemplate>
              </CollectionView.ItemTemplate>
            </CollectionView>
          </ScrollView>
        </VerticalStackLayout>
      </VerticalStackLayout>
    </Border>

    <controls:ThemedAlertOverlay x:Name="AlertOverlay" Grid.ColumnSpan="3" />
  </Grid>
</ContentPage>
