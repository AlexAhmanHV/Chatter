<?xml version="1.0" encoding="utf-8"?>
<!--
File: LoginPage.xaml

What this does:
- Purpose: Welcome/Login screen for signing into Chatter with email + password.
- How: Binds to LoginViewModel (Username, Password, IsBusy, CanLogin, LoginCommand) using compiled bindings (x:DataType).
       Styled with the app's shared Material theme (Resources/Styles/Theme.xaml, merged locally below - see the
       comment on ContentPage.Resources for why it's not merged at the App level) and UraniumUI.Material's TextField
       for real Material floating-label inputs, instead of a page-local hand-rolled palette. CreateAccountBtn is
       exposed by x:Name for code-behind to wire a “Create account” navigation.
- Where used: Entry point after app launch or when a session expires; navigates to Register or the main Chat page.
-->

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Chatter.Client.ViewModels"
    xmlns:material="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material"
    xmlns:symbols="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    x:Class="Chatter.Client.Views.LoginPage"
    x:ClassModifier="public"
    x:DataType="vm:LoginViewModel"
    Title="Welcome"
    BackgroundColor="{StaticResource ColorBackground}">

    <!-- Merged here, not in App.xaml: an Application-level StaticResource crashes natively on
         this MAUI/Windows build when read from a page (see App.xaml's comment) - every page
         merges Theme.xaml itself instead, which is proven safe and still gives one shared file. -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource ColorBackground}" Offset="0.0" />
                <GradientStop Color="{StaticResource ColorBackground}" Offset="0.35" />
                <GradientStop Color="#0A0F1A" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse WidthRequest="280" HeightRequest="280" Opacity="0.28"
                 HorizontalOptions="Start" VerticalOptions="Start" TranslationX="-120" TranslationY="-100">
            <Ellipse.Fill>
                <RadialGradientBrush Radius="0.9" Center="0.7,0.4">
                    <GradientStop Color="{StaticResource ColorPrimaryVariant}" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse WidthRequest="340" HeightRequest="340" Opacity="0.22"
                 HorizontalOptions="End" VerticalOptions="End" TranslationX="80" TranslationY="120">
            <Ellipse.Fill>
                <RadialGradientBrush Radius="1.0" Center="0.3,0.6">
                    <GradientStop Color="{StaticResource ColorPrimary}" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollView>
            <VerticalStackLayout Padding="28,56" Spacing="24" VerticalOptions="Center">

                <VerticalStackLayout Spacing="8" Margin="0,0,0,4">
                    <Label Text="{x:Static symbols:MaterialOutlined.Forum}"
                           Style="{StaticResource IconGlyph}"
                           FontSize="56"
                           TextColor="{StaticResource ColorPrimary}" />
                    <Label Text="Chatter" Style="{StaticResource TypeDisplay}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <Label Text="Connect with friends and family"
                           Style="{StaticResource TypeCaption}"
                           HorizontalOptions="Center"
                           Opacity="0.95" />
                </VerticalStackLayout>

                <Border Style="{StaticResource CardBorder}" Padding="24,28" Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="18">

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{x:Static symbols:MaterialOutlined.Mail}" Style="{StaticResource IconGlyph}" />
                            <material:TextField Grid.Column="1"
                                   x:Name="EmailEntry"
                                   Title="Email"
                                   Text="{Binding Username}"
                                   ReturnType="Next"
                                   Keyboard="Email" />
                            <ActivityIndicator Grid.Column="2"
                                               IsVisible="{Binding IsBusy}"
                                               IsRunning="{Binding IsBusy}"
                                               Color="{StaticResource ColorPrimary}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{x:Static symbols:MaterialOutlined.Lock}" Style="{StaticResource IconGlyph}" />
                            <material:TextField Grid.Column="1"
                                   x:Name="PasswordEntry"
                                   Title="Password"
                                   Text="{Binding Password}"
                                   IsPassword="True"
                                   ReturnType="Go" />
                        </Grid>

                        <Button Text="Log in"
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding CanLogin}"
                                Style="{StaticResource PrimaryButton}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Text" Value="Signing you in…" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Grid ColumnDefinitions="*,Auto,*" Margin="0,6,0,0" ColumnSpacing="12">
                            <BoxView Grid.Column="0" HeightRequest="1" BackgroundColor="{StaticResource ColorOutline}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="or" Style="{StaticResource TypeCaption}" VerticalOptions="Center" />
                            <BoxView Grid.Column="2" HeightRequest="1" BackgroundColor="{StaticResource ColorOutline}" VerticalOptions="Center" />
                        </Grid>

                        <Button x:Name="CreateAccountBtn"
                                Text="Create account"
                                Style="{StaticResource SecondaryButton}" />

                        <Label Style="{StaticResource TypeCaption}"
                               HorizontalOptions="Center"
                               Margin="0,4,0,0">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ShowServerSettings}" Value="True">
                                    <Setter Property="Text" Value="Server address ▲" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding ShowServerSettings}" Value="False">
                                    <Setter Property="Text" Value="Server address ▼" />
                                </DataTrigger>
                            </Label.Triggers>
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleServerSettingsCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowServerSettings}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="{x:Static symbols:MaterialOutlined.Public}" Style="{StaticResource IconGlyph}" />
                                <material:TextField Grid.Column="1"
                                       Title="Server address"
                                       Text="{Binding ServerUrl}"
                                       Keyboard="Url" />
                            </Grid>
                            <Label Text="Only needed if the app isn't running on the same computer as the server - point it at your server's address, e.g. its LAN IP."
                                   Style="{StaticResource TypeCaption}"
                                   FontSize="11" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Label
                    Text="By continuing, you agree to our Terms of Service and Privacy Policy"
                    Style="{StaticResource TypeCaption}"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Margin="6,2,6,24" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
