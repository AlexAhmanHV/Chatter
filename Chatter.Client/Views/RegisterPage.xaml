<?xml version="1.0" encoding="utf-8" ?>
<!--
File: RegisterPage.xaml

What this does:
- Purpose: The registration (sign-up) screen. Collects Email, Password (and optional confirmation),
  shows helpful copy, and exposes a single “Create account” action bound to RegisterViewModel.RegisterCommand.
- How: Styled with the app's shared Material theme (Resources/Styles/Theme.xaml, merged locally - see
  LoginPage.xaml's comment on why not at the App level) and UraniumUI.Material's TextField for real
  floating-label inputs. The “Log in” link is wired to NavigateToLoginCommand on the VM, and the
  Register button binds to RegisterCommand.
-->

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Chatter.Client.ViewModels"
    xmlns:material="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material"
    xmlns:symbols="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    x:Class="Chatter.Client.Views.RegisterPage"
    x:DataType="vm:RegisterViewModel"
    Title="Create account"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{StaticResource ColorBackground}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource ColorBackground}" Offset="0.0" />
                <GradientStop Color="{StaticResource ColorBackground}" Offset="0.35" />
                <GradientStop Color="#0A0F1A" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse WidthRequest="280" HeightRequest="280" Opacity="0.28"
                 HorizontalOptions="Start" VerticalOptions="Start" TranslationX="-120" TranslationY="-100">
            <Ellipse.Fill>
                <RadialGradientBrush Radius="0.9" Center="0.7,0.4">
                    <GradientStop Color="{StaticResource ColorPrimaryVariant}" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse WidthRequest="340" HeightRequest="340" Opacity="0.22"
                 HorizontalOptions="End" VerticalOptions="End" TranslationX="80" TranslationY="120">
            <Ellipse.Fill>
                <RadialGradientBrush Radius="1.0" Center="0.3,0.6">
                    <GradientStop Color="{StaticResource ColorPrimary}" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollView>
            <VerticalStackLayout Padding="28,56" Spacing="24" VerticalOptions="Center">

                <VerticalStackLayout Spacing="8" Margin="0,0,0,4">
                    <Label Text="{x:Static symbols:MaterialOutlined.Person_add}"
                           Style="{StaticResource IconGlyph}"
                           FontSize="48"
                           TextColor="{StaticResource ColorPrimary}" />
                    <Label Text="Join Chatter" Style="{StaticResource TypeDisplay}" FontSize="34" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <Label Text="Create your account to get started"
                           Style="{StaticResource TypeCaption}"
                           HorizontalOptions="Center"
                           Opacity="0.95" />
                </VerticalStackLayout>

                <Border Style="{StaticResource CardBorder}" Padding="24,28" Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="18">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{x:Static symbols:MaterialOutlined.Mail}" Style="{StaticResource IconGlyph}" />
                            <material:TextField Grid.Column="1"
                                   Title="Email address"
                                   Text="{Binding Email}"
                                   Keyboard="Email"
                                   ReturnType="Next" />
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="{x:Static symbols:MaterialOutlined.Lock}" Style="{StaticResource IconGlyph}" />
                                <material:TextField Grid.Column="1"
                                       Title="Password"
                                       Text="{Binding Password}"
                                       IsPassword="True"
                                       ReturnType="Next" />
                            </Grid>
                            <Label Text="Must be at least 6 characters"
                                   Style="{StaticResource TypeCaption}"
                                   FontSize="12"
                                   Margin="36,0,0,0" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{x:Static symbols:MaterialOutlined.Check_circle}" Style="{StaticResource IconGlyph}" />
                            <material:TextField Grid.Column="1"
                                   Title="Confirm password"
                                   Text="{Binding ConfirmPassword}"
                                   IsPassword="True"
                                   ReturnType="Go" />
                        </Grid>

                        <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                            <Label Text="{x:Static symbols:MaterialOutlined.Description}" Style="{StaticResource IconGlyph}" FontSize="16" />
                            <Label VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="By signing up, you agree to our "
                                              FontSize="12"
                                              TextColor="{StaticResource ColorOnSurfaceVariant}" />
                                        <Span Text="Terms"
                                              FontSize="12"
                                              TextColor="{StaticResource ColorPrimaryVariant}"
                                              FontAttributes="Bold"
                                              TextDecorations="Underline" />
                                        <Span Text=" and "
                                              FontSize="12"
                                              TextColor="{StaticResource ColorOnSurfaceVariant}" />
                                        <Span Text="Privacy Policy"
                                              FontSize="12"
                                              TextColor="{StaticResource ColorPrimaryVariant}"
                                              FontAttributes="Bold"
                                              TextDecorations="Underline" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </HorizontalStackLayout>

                        <Button Text="Create account"
                                Command="{Binding RegisterCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,8,0,0" />

                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,14,0,0">
                            <Label Text="Already have an account?"
                                   Style="{StaticResource TypeCaption}"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                            <Label Text="Log in"
                                   FontSize="14"
                                   TextColor="{StaticResource ColorOnSurface}"
                                   FontAttributes="Bold"
                                   TextDecorations="Underline"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,6,0,24">
                    <Label Text="{x:Static symbols:MaterialOutlined.Lock}" Style="{StaticResource IconGlyph}" FontSize="16" />
                    <Label Text="Your information is secure and encrypted"
                           Style="{StaticResource TypeCaption}"
                           FontSize="12"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Button Text="{x:Static symbols:MaterialOutlined.Arrow_back}"
                FontFamily="MaterialSymbolsOutlined"
                Command="{Binding NavigateToLoginCommand}"
                WidthRequest="40" HeightRequest="40" FontSize="20" Padding="0"
                BackgroundColor="{StaticResource ColorSurfaceVariant}" TextColor="{StaticResource ColorOnSurface}"
                CornerRadius="20"
                HorizontalOptions="Start" VerticalOptions="Start" Margin="20,20,0,0" />

        <Grid x:Name="SuccessOverlay" IsVisible="False" BackgroundColor="#B3000000">
            <Border Style="{StaticResource CardBorder}" WidthRequest="300" Padding="28,32"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="{x:Static symbols:MaterialOutlined.Check_circle}"
                           FontFamily="MaterialSymbolsOutlined" FontSize="48"
                           TextColor="{StaticResource ColorSuccess}" HorizontalOptions="Center" />
                    <Label Text="Account created!" Style="{StaticResource TypeTitle}" HorizontalOptions="Center" />
                    <Label Text="Taking you to log in…" Style="{StaticResource TypeCaption}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
