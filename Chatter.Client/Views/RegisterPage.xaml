<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Chatter.Client.ViewModels"
    x:Class="Chatter.Client.Views.RegisterPage"
    x:DataType="vm:RegisterViewModel"
    Title="Create account">

    <VerticalStackLayout Padding="24" Spacing="14">
        <Entry Text="{Binding Email}" Placeholder="Email" Keyboard="Email" />
        <Entry Text="{Binding Password}" Placeholder="Password" IsPassword="True" />
        <Entry Text="{Binding ConfirmPassword}" Placeholder="Confirm password" IsPassword="True" />
        <Button Text="Register" Command="{Binding RegisterCommand}" />
    </VerticalStackLayout>

</ContentPage>