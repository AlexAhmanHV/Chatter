<?xml version="1.0" encoding="utf-8"?>
<!--
File: SettingsPage.xaml

What this does:
- Purpose: User settings screen to edit profile info (currently just the display name) with themed, MAUI-styled UI.
- How: Binds to SettingsViewModel (DisplayName, SaveCommand) using compiled bindings (x:DataType).
       Styled with the app's shared Material theme (Resources/Styles/Theme.xaml, merged locally - see
       LoginPage.xaml's comment on why not at the App level). The “Save changes” button invokes SaveCommand;
       Entry's ReturnCommand also points to SaveCommand for quick submit.
- Where used: Pushed from ChatPage toolbar (“Settings”). On successful save, the VM shows a toast/alert and navigates back.
-->

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Chatter.Client.ViewModels"
    xmlns:material="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material"
    xmlns:symbols="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    x:Class="Chatter.Client.Views.SettingsPage"
    x:ClassModifier="public"
    x:DataType="vm:SettingsViewModel"
    Title="User settings"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{StaticResource ColorBackground}">

  <ContentPage.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Styles/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </ContentPage.Resources>

  <Grid Padding="28" RowSpacing="0" ColumnSpacing="0">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource ColorBackground}" Offset="0.0" />
        <GradientStop Color="{StaticResource ColorBackground}" Offset="0.35" />
        <GradientStop Color="#0A0F1A" Offset="1.0" />
      </LinearGradientBrush>
    </Grid.Background>

    <Ellipse WidthRequest="260" HeightRequest="260" Opacity="0.22"
             HorizontalOptions="Start" VerticalOptions="Start" TranslationX="-120" TranslationY="-120">
      <Ellipse.Fill>
        <RadialGradientBrush Radius="0.9" Center="0.7,0.4">
          <GradientStop Color="{StaticResource ColorPrimaryVariant}" Offset="0" />
          <GradientStop Color="#00000000" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse WidthRequest="320" HeightRequest="320" Opacity="0.18"
             HorizontalOptions="End" VerticalOptions="End" TranslationX="80" TranslationY="120">
      <Ellipse.Fill>
        <RadialGradientBrush Radius="1.0" Center="0.3,0.6">
          <GradientStop Color="{StaticResource ColorPrimary}" Offset="0" />
          <GradientStop Color="#00000000" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <ScrollView>
      <VerticalStackLayout Spacing="22">

        <VerticalStackLayout Spacing="8" Margin="0,8,0,0">
          <Label Text="{x:Static symbols:MaterialOutlined.Settings}"
                 Style="{StaticResource IconGlyph}"
                 FontSize="48"
                 TextColor="{StaticResource ColorPrimary}" />
          <Label Text="Settings" Style="{StaticResource TypeDisplay}" FontSize="32" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
          <Label Text="Customize your profile"
                 Style="{StaticResource TypeCaption}"
                 HorizontalOptions="Center"
                 Opacity="0.95" />
        </VerticalStackLayout>

        <Border Style="{StaticResource CardBorder}">
          <VerticalStackLayout Spacing="24">

            <HorizontalStackLayout Spacing="12">
              <Label Text="{x:Static symbols:MaterialOutlined.Person}" Style="{StaticResource IconGlyph}" />
              <Label Text="Profile Information" Style="{StaticResource TypeTitle}" FontSize="18" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
              <Border WidthRequest="88" HeightRequest="88" StrokeThickness="2" Stroke="{StaticResource ColorOutline}"
                      BackgroundColor="{StaticResource ColorSurfaceVariant}" HorizontalOptions="Center">
                <Border.StrokeShape>
                  <RoundRectangle CornerRadius="44" />
                </Border.StrokeShape>
                <Image Source="{Binding AvatarPreview}" Aspect="AspectFill" WidthRequest="84" HeightRequest="84" />
              </Border>
              <Button Text="Change avatar"
                      Command="{Binding PickAvatarCommand}"
                      Style="{StaticResource SecondaryButton}"
                      FontSize="13"
                      HeightRequest="38"
                      Padding="16,0" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
              <Label Text="Display name" Style="{StaticResource TypeCaption}" FontAttributes="Bold" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Grid.Column="0" Text="{x:Static symbols:MaterialOutlined.Edit}" Style="{StaticResource IconGlyph}" />
                <material:TextField Grid.Column="1"
                       Text="{Binding DisplayName}"
                       Title="Your name"
                       ReturnType="Done"
                       ReturnCommand="{Binding SaveCommand}" />
              </Grid>
              <Label Text="This is how others will see you in chats"
                     Style="{StaticResource TypeCaption}"
                     FontSize="12" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" BackgroundColor="{StaticResource ColorOutline}" Opacity="0.8" />

            <VerticalStackLayout Spacing="14">
              <HorizontalStackLayout Spacing="12">
                <Label Text="{x:Static symbols:MaterialOutlined.Info}" Style="{StaticResource IconGlyph}" FontSize="20" />
                <Label Text="Account Information" Style="{StaticResource TypeTitle}" FontSize="16" VerticalOptions="Center" />
              </HorizontalStackLayout>

              <Border BackgroundColor="#082638"
                      Padding="14"
                      StrokeThickness="1"
                      Stroke="#0B3B57">
                <Border.StrokeShape>
                  <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Label Grid.Column="0" Text="{x:Static symbols:MaterialOutlined.Lightbulb}" Style="{StaticResource IconGlyph}" FontSize="18" TextColor="{StaticResource ColorPrimaryVariant}" />
                  <Label Grid.Column="1" VerticalOptions="Center">
                    <Label.FormattedText>
                      <FormattedString>
                        <Span Text="Tip: "
                              FontAttributes="Bold"
                              TextColor="{StaticResource ColorPrimaryVariant}"
                              FontSize="13" />
                        <Span Text="Choose a name that your friends will recognize easily!"
                              TextColor="{StaticResource ColorOnSurface}"
                              FontSize="13" />
                      </FormattedString>
                    </Label.FormattedText>
                  </Label>
                </Grid>
              </Border>
            </VerticalStackLayout>

            <Button Text="Save changes"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButton}" />

            <Border x:Name="SuccessMessage"
                    BackgroundColor="#052E22"
                    Padding="12"
                    StrokeThickness="1"
                    Stroke="{StaticResource ColorSuccess}"
                    IsVisible="False">
              <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
              </Border.StrokeShape>
              <HorizontalStackLayout Spacing="8">
                <Label Text="{x:Static symbols:MaterialOutlined.Check}"
                       Style="{StaticResource IconGlyph}"
                       FontSize="18"
                       TextColor="{StaticResource ColorSuccess}" />
                <Label Text="Settings saved successfully!"
                       FontSize="14"
                       TextColor="#A7F3D0"
                       VerticalOptions="Center" />
              </HorizontalStackLayout>
            </Border>

          </VerticalStackLayout>
        </Border>

      </VerticalStackLayout>
    </ScrollView>

    <Button Text="{x:Static symbols:MaterialOutlined.Arrow_back}"
            FontFamily="MaterialSymbolsOutlined"
            Clicked="OnBackClicked"
            WidthRequest="40" HeightRequest="40" FontSize="20" Padding="0"
            BackgroundColor="{StaticResource ColorSurfaceVariant}" TextColor="{StaticResource ColorOnSurface}"
            CornerRadius="20"
            HorizontalOptions="Start" VerticalOptions="Start" />
  </Grid>
</ContentPage>
