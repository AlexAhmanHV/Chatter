<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Chatter.Client.ViewModels"
    x:Class="Chatter.Client.Views.SettingsPage"
    x:DataType="vm:SettingsViewModel"
    Title="User settings"
    BackgroundColor="#0B1220">

    <!-- ===== Resources / Tokens ===== -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Palette -->
            <Color x:Key="PrimaryStart">#6EE7F9</Color>   <!-- cyan -->
            <Color x:Key="PrimaryEnd">#8B5CF6</Color>     <!-- violet -->
            <Color x:Key="CardBg">#101827</Color>         <!-- near-black card -->
            <Color x:Key="PanelBg">#0D1524</Color>        <!-- input bg -->
            <Color x:Key="TextPrimary">#E5E7EB</Color>
            <Color x:Key="TextSecondary">#9CA3AF</Color>
            <Color x:Key="StrokeIdle">#1F2937</Color>
            <Color x:Key="StrokeFocus">#8B5CF6</Color>
            <Color x:Key="SuccessBg">#052E22</Color>
            <Color x:Key="SuccessStroke">#16A34A</Color>

            <!-- Radii -->
            <x:Double x:Key="RadiusLg">20</x:Double>
            <x:Double x:Key="RadiusMd">14</x:Double>

            <!-- Typography -->
            <Style TargetType="Label" x:Key="H1">
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>
            <Style TargetType="Label" x:Key="Subtle">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            </Style>

            <!-- Card -->
            <Style TargetType="Border" x:Key="Card">
                <Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
                <Setter Property="Stroke" Value="{StaticResource StrokeIdle}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="24,28" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="{StaticResource RadiusLg}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Opacity="0.28" Radius="22" Offset="0,12" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Field container with focus states -->
            <Style TargetType="Border" x:Key="FieldBorder">
                <Setter Property="Stroke" Value="{StaticResource StrokeIdle}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="BackgroundColor" Value="{StaticResource PanelBg}" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="{StaticResource RadiusMd}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <Setter.Value>
                        <VisualStateGroupList>
                            <VisualStateGroup>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Property="Stroke" Value="{StaticResource StrokeFocus}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary gradient button -->
            <Style TargetType="Button" x:Key="PrimaryBtn">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{StaticResource PrimaryStart}" Offset="0.0" />
                            <GradientStop Color="{StaticResource PrimaryEnd}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Opacity="0.35" Radius="16" Offset="0,6" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Header gradient -->
            <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{StaticResource PrimaryStart}" Offset="0.0" />
                <GradientStop Color="{StaticResource PrimaryEnd}" Offset="1.0" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- ===== Layout ===== -->
    <Grid Padding="28" RowSpacing="0" ColumnSpacing="0">
        <!-- Background gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0B1220" Offset="0.0" />
                <GradientStop Color="#0B1220" Offset="0.35" />
                <GradientStop Color="#0A0F1A" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Decorative gradient blobs -->
        <Ellipse WidthRequest="260" HeightRequest="260" Opacity="0.22"
                 HorizontalOptions="Start" VerticalOptions="Start" TranslationX="-120" TranslationY="-120">
            <Ellipse.Fill>
                <RadialGradientBrush Radius="0.9" Center="0.7,0.4">
                    <GradientStop Color="{StaticResource PrimaryStart}" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse WidthRequest="320" HeightRequest="320" Opacity="0.18"
                 HorizontalOptions="End" VerticalOptions="End" TranslationX="80" TranslationY="120">
            <Ellipse.Fill>
                <RadialGradientBrush Radius="1.0" Center="0.3,0.6">
                    <GradientStop Color="{StaticResource PrimaryEnd}" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollView>
            <VerticalStackLayout Spacing="22">

                <!-- Header -->
                <VerticalStackLayout Spacing="8" Margin="0,8,0,0">
                    <Label Text="⚙" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Settings" Style="{StaticResource H1}" />
                    <Label Text="Customize your profile"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource TextSecondary}"
                           Opacity="0.95" />
                </VerticalStackLayout>

                <!-- Card -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="24">

                        <!-- Profile section title -->
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="👤" FontSize="22" VerticalOptions="Center" />
                            <Label Text="Profile Information"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Display name field -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Display name" Style="{StaticResource Subtle}" FontAttributes="Bold" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="✏️" VerticalOptions="Center" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           Placeholder="Your name"
                                           ReturnType="Done"
                                           ReturnCommand="{Binding SaveCommand}"
                                           TextColor="{StaticResource TextPrimary}"
                                           PlaceholderColor="{StaticResource TextSecondary}"
                                           BackgroundColor="Transparent" />
                                </Grid>
                            </Border>
                            <Label Text="This is how others will see you in chats"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>

                        <!-- Divider -->
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource StrokeIdle}" Opacity="0.8" />

                        <!-- Account info / tip -->
                        <VerticalStackLayout Spacing="14">
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="ℹ" FontSize="20" VerticalOptions="Center" />
                                <Label Text="Account Information"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Tip pill -->
                            <Border BackgroundColor="#082638"
                                    Padding="14"
                                    StrokeThickness="1"
                                    Stroke="#0B3B57">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="💡" FontSize="18" VerticalOptions="Center" />
                                    <Label Grid.Column="1" VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Tip: "
                                                      FontAttributes="Bold"
                                                      TextColor="#6EE7F9"
                                                      FontSize="13" />
                                                <Span Text="Choose a name that your friends will recognize easily!"
                                                      TextColor="{StaticResource TextPrimary}"
                                                      FontSize="13" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Save button -->
                        <Button Text="Save changes"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryBtn}" />

                        <!-- Success message (toggle visibility in code or bind later) -->
                        <Border x:Name="SuccessMessage"
                                BackgroundColor="{StaticResource SuccessBg}"
                                Padding="12"
                                StrokeThickness="1"
                                Stroke="{StaticResource SuccessStroke}"
                                IsVisible="False">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="✓"
                                       FontSize="18"
                                       TextColor="{StaticResource SuccessStroke}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Label Text="Settings saved successfully!"
                                       FontSize="14"
                                       TextColor="#A7F3D0"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
